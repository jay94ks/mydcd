# containerd and runc that ship inside the sfcd package, next to sfed. They are
# the versions the pinned Moby tag builds against (seafield/upstream.json,
# ARG CONTAINERD_VERSION and RUNC_VERSION in its Dockerfile). Bump them with
# the upstream tag. The commit is the tag's commit and is checked after clone.
CONTAINERD_VERSION=v2.4.2
CONTAINERD_COMMIT=b7a25261e029d68978bbf290df0a62fc819b3c51
RUNC_VERSION=v1.5.3
RUNC_COMMIT=46365c62967c76a765a5e347f48f0c7b3b571fe9
