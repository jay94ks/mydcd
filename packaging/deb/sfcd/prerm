#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Removing (not upgrading) stops and disables both units. Nothing is deleted.
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	echo "sfcd: stopping sfcd and sfed; this server's containers stop with sfed." >&2
	deb-systemd-invoke stop sfcd.service sfed.service || true
	deb-systemd-helper disable sfcd.service sfed.service >/dev/null 2>&1 || true
fi
exit 0
