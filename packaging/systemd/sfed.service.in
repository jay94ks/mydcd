# SPDX-License-Identifier: Apache-2.0
# Seafield Engine. @LIBDIR@ is /usr/lib/sfc (deb, rpm) or /usr/local/lib/sfc
# (archive); packaging/layout.sh fills it in. sfed starts its own containerd
# and runc from @LIBDIR@/bin, never the system ones.
[Unit]
Description=Seafield Engine (sfed)
Documentation=https://github.com/jay94ks/seafield/tree/main/seafield/docs
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sfc/node.yaml

[Service]
Type=notify
Environment=PATH=@LIBDIR@/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SFE_RUNC=@LIBDIR@/bin/runc
ConfigurationDirectory=sfe
# The per-server values come from node.yaml engine (sfcd engine-config).
ExecStartPre=@LIBDIR@/bin/sfcd --config /etc/sfc/node.yaml engine-config --output /etc/sfe/daemon.json
ExecStart=@LIBDIR@/bin/sfed --config-file /etc/sfe/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
Delegate=yes
KillMode=process
LimitNOFILE=infinity
LimitNPROC=infinity
TasksMax=infinity
OOMScoreAdjust=-500
Restart=always
RestartSec=2
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
