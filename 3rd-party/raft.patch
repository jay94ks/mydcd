+// followerTimeout is how long a follower goes without leader contact before
+// it starts an election. With HeartbeatInterval set, a follower that knows
+// no leader (startup, or the leader stepped down) only waits ElectionTimeout:
+// HeartbeatTimeout is sized for a long heartbeat interval and would delay the
+// first election for no reason.
+func (r *Raft) followerTimeout() time.Duration {
+	c := r.config()
+	if c.HeartbeatInterval > 0 {
+		if _, id := r.LeaderWithID(); id == "" {
+			return c.ElectionTimeout
+		}
+	}
+	return c.HeartbeatTimeout
+}
