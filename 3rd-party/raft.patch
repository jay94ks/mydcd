+// peerLost is a PeerConnectionLost report.
+type peerLost struct {
+	id ServerID
+	at time.Time
+}
+
+// PeerConnectionLost tells Raft that the transport lost its connection to
+// id (idle timeout, peer shutdown or reset), not that it closed one itself.
+// A follower whose leader is id starts an election after a short random
+// delay instead of waiting for HeartbeatTimeout. A leader treats id as not
+// contacted and re-checks its lease at once, stepping down if it no longer
+// reaches a quorum. Contact after the report cancels it. Terms, votes, the
+// lease rule and log matching are unchanged, so it only changes how soon a
+// failure is acted on. It never blocks; reports beyond a small buffer are
+// dropped and the timers still apply.
+func (r *Raft) PeerConnectionLost(id ServerID) {
+	select {
+	case r.peerLostCh <- peerLost{id: id, at: time.Now()}:
+	default:
+	}
+}
+
+// PeerConnected tells Raft that the transport has a connection to id again
+// (for example the peer restarted). A leader sends that follower a heartbeat
+// at once instead of at its next HeartbeatInterval, so a restarted follower
+// learns its leader without waiting a whole interval. Others ignore it. It
+// never blocks; reports beyond a small buffer are dropped and the timers
+// still apply.
+func (r *Raft) PeerConnected(id ServerID) {
+	select {
+	case r.peerFoundCh <- id:
+	default:
+	}
+}
