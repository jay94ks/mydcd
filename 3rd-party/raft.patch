+// replicationIdle reports whether the follower already holds every entry up
+// to lastLogIdx and reported the leader's current commit index, so an empty
+// AppendEntries would tell it nothing. The leader wakes replication on every
+// commit index advance (leaderLoop) and whenever a heartbeat response shows
+// the follower behind, so the CommitTimeout poll only retries what those
+// wake-ups could not deliver.
+func (r *Raft) replicationIdle(s *followerReplication, lastLogIdx uint64) bool {
+	return s.failures == 0 &&
+		atomic.LoadUint64(&s.nextIndex) > lastLogIdx &&
+		s.followerCommit.Load() >= r.getCommitIndex()
+}
