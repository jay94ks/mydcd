+// heartbeatWait returns the wait before the next heartbeat.
+func heartbeatWait(c Config) <-chan time.Time {
+	if c.HeartbeatInterval <= 0 {
+		return randomTimeout(c.HeartbeatTimeout / 10)
+	}
+	jitter := time.Duration(rand.Int63n(int64(c.HeartbeatInterval/10) + 1))
+	return time.After(c.HeartbeatInterval + jitter)
+}
+
+// randomDelay returns a channel that fires after a random wait in [0, maxVal].
+func randomDelay(maxVal time.Duration) <-chan time.Time {
+	return time.After(time.Duration(rand.Int63n(int64(maxVal) + 1)))
+}
