diff --git a/daemon/seafield/logqueue/queue.go b/daemon/seafield/logqueue/queue.go
index f964bd4..cb8f26d 100644
--- a/daemon/seafield/logqueue/queue.go
+++ b/daemon/seafield/logqueue/queue.go
@@ -63,8 +63,25 @@ type Queue struct {
 	next   uint64
 	notify chan struct{}
 	closed bool
+
+	// OnData, when set, says "lines up to seq are stored" without the data;
+	// the reader pulls the lines itself and acks them. It is debounced: it
+	// runs Quiet after the last Append, each Append within Quiet moves it
+	// later, and a steady stream still gets one at least every MaxWait.
+	// Close runs a pending one at once.
+	OnData  func(seq uint64)
+	Quiet   time.Duration
+	MaxWait time.Duration
+	timer   *time.Timer
+	gen     uint64
+	since   time.Time // first Append not yet announced
+	acked   uint64    // highest number the reader acknowledged; kept in ackFile
 }
 
+// ackFile keeps the acknowledged number, so numbering continues after the
+// queue was emptied by an ack and the engine restarted.
+const ackFile = "acked"
+
 // Open opens or creates the queue in dir, continuing its numbers.
 func Open(dir string, maxSize int64) (*Queue, error) {
 	if maxSize <= 0 {
@@ -73,7 +90,7 @@ func Open(dir string, maxSize int64) (*Queue, error) {
 	if err := os.MkdirAll(dir, 0o700); err != nil {
 		return nil, err
 	}
-	q := &Queue{dir: dir, maxSize: maxSize, segSize: max(maxSize/8, minSegment), next: 1, notify: make(chan struct{})}
+	q := &Queue{dir: dir, maxSize: maxSize, segSize: max(maxSize/8, minSegment), next: 1, notify: make(chan struct{}), Quiet: 500 * time.Millisecond, MaxWait: 5 * time.Second}
 	if err := q.scan(); err != nil {
 		return nil, err
 	}
@@ -101,6 +118,12 @@ func (q *Queue) scan() error {
 		q.segs = append(q.segs, first)
 		q.sizes = append(q.sizes, info.Size())
 	}
+	if b, err := os.ReadFile(filepath.Join(q.dir, ackFile)); err == nil {
+		if n, err := strconv.ParseUint(strings.TrimSpace(string(b)), 10, 64); err == nil {
+			q.acked = n
+			q.next = max(q.next, n+1)
+		}
+	}
 	if len(q.segs) == 0 {
 		return nil
 	}
@@ -166,12 +189,44 @@ func (q *Queue) Append(t time.Time, stream string, partial bool, data []byte) er
 	}
 	q.sizes[len(q.sizes)-1] += int64(headerSize + len(data))
 	q.next++
+	q.scheduleLocked()
 	q.trimLocked()
 	close(q.notify)
 	q.notify = make(chan struct{})
 	return nil
 }
 
+func (q *Queue) scheduleLocked() {
+	if q.OnData == nil {
+		return
+	}
+	now := time.Now()
+	if q.since.IsZero() {
+		q.since = now
+	}
+	delay := min(q.Quiet, q.since.Add(q.MaxWait).Sub(now))
+	if q.timer != nil {
+		q.timer.Stop()
+	}
+	q.gen++
+	gen := q.gen
+	q.timer = time.AfterFunc(max(delay, 0), func() { q.announce(gen) })
+}
+
+// announce runs OnData for the pending lines unless a later Append
+// rescheduled it (gen 0 = now, from Close).
+func (q *Queue) announce(gen uint64) {
+	q.mu.Lock()
+	if q.since.IsZero() || gen != 0 && gen != q.gen {
+		q.mu.Unlock()
+		return
+	}
+	q.since, q.timer = time.Time{}, nil
+	seq, f := q.next-1, q.OnData
+	q.mu.Unlock()
+	f(seq)
+}
+
 func (q *Queue) rotate() error {
 	if q.cur != nil {
 		if err := q.cur.Close(); err != nil {
@@ -206,10 +261,29 @@ func (q *Queue) trimLocked() {
 func (q *Queue) Ack(upto uint64) {
 	q.mu.Lock()
 	defer q.mu.Unlock()
+	upto = min(upto, q.next-1)
+	if upto <= q.acked {
+		return
+	}
+	q.acked = upto
+	tmp := filepath.Join(q.dir, ackFile+".tmp")
+	if err := os.WriteFile(tmp, []byte(strconv.FormatUint(upto, 10)), 0o600); err == nil {
+		_ = os.Rename(tmp, filepath.Join(q.dir, ackFile))
+	}
 	for len(q.segs) > 1 && q.segs[1]-1 <= upto {
 		_ = os.Remove(filepath.Join(q.dir, segName(q.segs[0])))
 		q.segs, q.sizes = q.segs[1:], q.sizes[1:]
 	}
+	// Everything taken: drop the segment being written too. The next
+	// Append opens a new one at q.next.
+	if upto == q.next-1 && len(q.segs) == 1 {
+		if q.cur != nil {
+			_ = q.cur.Close()
+			q.cur = nil
+		}
+		_ = os.Remove(filepath.Join(q.dir, segName(q.segs[0])))
+		q.segs, q.sizes = nil, nil
+	}
 }
 
 // Read returns up to limit lines numbered after `after`, a Gap when some of
@@ -220,14 +294,20 @@ func (q *Queue) Read(after uint64, limit int) ([]Line, *Gap, <-chan struct{}, er
 	segs := slices.Clone(q.segs)
 	next := q.next
 	changed := q.notify
+	after = max(after, q.acked) // acknowledged lines are gone, not a gap
 	q.mu.Unlock()
 	return readDir(q.dir, segs, next, after, limit, changed)
 }
 
 // Close closes the segment being written.
 func (q *Queue) Close() error {
+	q.announce(0) // the container's last lines are not held back
 	q.mu.Lock()
 	defer q.mu.Unlock()
+	if q.timer != nil {
+		q.timer.Stop()
+		q.timer = nil
+	}
 	q.closed = true
 	close(q.notify)
 	q.notify = make(chan struct{})
