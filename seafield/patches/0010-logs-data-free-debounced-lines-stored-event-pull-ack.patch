+
+func TestOnDataDebounced(t *testing.T) {
+	q, _ := Open(t.TempDir(), 0)
+	defer q.Close()
+	q.Quiet, q.MaxWait = 100*time.Millisecond, 400*time.Millisecond
+	got := make(chan uint64, 16)
+	q.OnData = func(seq uint64) { got <- seq }
+	start := time.Now()
+	// a line every 40ms for 1s: Quiet never passes, MaxWait must still fire
+	for time.Since(start) < time.Second {
+		appendN(t, q, 1, 1)
+		time.Sleep(40 * time.Millisecond)
+	}
+	n := len(got)
+	if n < 2 || n > 3 {
+		t.Fatalf("steady stream: %d events in 1s with MaxWait 400ms", n)
+	}
+	// then quiet: one more event about Quiet after the last line, with it
+	select {
+	case seq := <-drain(got):
+		if seq != q.next-1 {
+			t.Fatalf("last event seq %d, stored %d", seq, q.next-1)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("no event after the stream stopped")
+	}
+	appendN(t, q, 1, 1)
+	q.Close() // pending event fires at once
+	select {
+	case <-got:
+	case <-time.After(50 * time.Millisecond):
+		t.Fatal("Close held the pending event back")
+	}
+}
+
+// drain returns a channel yielding the last value sent on c within 300ms.
+func drain(c chan uint64) <-chan uint64 {
+	out := make(chan uint64, 1)
+	go func() {
+		var last uint64
+		for {
+			select {
+			case v := <-c:
+				last = v
+			case <-time.After(300 * time.Millisecond):
+				out <- last
+				return
+			}
+		}
+	}()
+	return out
+}
+
