+
+// notifyTimes reads the debounce of the "lines stored" event. Defaults:
+// 500ms after the last line, at least once every 5s under a steady stream.
+// The bound exists so a chatty container cannot flood the event feed and
+// stall the engine and sfcd (Jay 2026-11-27). Seafield Cluster sets them per node (node.yaml).
+func notifyTimes(cfg map[string]string) (quiet, maxWait time.Duration, err error) {
+	quiet, maxWait = 500*time.Millisecond, 5*time.Second
+	if v := cfg["notify-quiet"]; v != "" {
+		if quiet, err = time.ParseDuration(v); err != nil || quiet < 10*time.Millisecond || quiet > 10*time.Second {
+			return 0, 0, fmt.Errorf("%s: notify-quiet must be 10ms..10s, got %q", Name, v)
+		}
+	}
+	if v := cfg["notify-max-wait"]; v != "" {
+		if maxWait, err = time.ParseDuration(v); err != nil || maxWait > time.Minute {
+			return 0, 0, fmt.Errorf("%s: notify-max-wait must be at most 1m, got %q", Name, v)
+		}
+	}
+	if maxWait < quiet {
+		return 0, 0, fmt.Errorf("%s: notify-max-wait (%s) is shorter than notify-quiet (%s)", Name, maxWait, quiet)
+	}
+	return quiet, maxWait, nil
 }
 
 // Dir is where the queue of container id lives.
+// Notify, set by the daemon, publishes "the queue of container id has
+// lines up to seq" as an engine event (action seafield.logs). The event
+// carries no log data; sfcd pulls the lines and acks them. It is debounced
+// per queue (notify-quiet, notify-max-wait).
+var Notify func(id string, seq uint64)
+
 func Dir(id string) string { return filepath.Join(Root, "containers", id, "seafield-logs") }
 
 type driver struct {
@@ -70,6 +102,14 @@ func newDriver(info logger.Info) (logger.Logger, error) {
