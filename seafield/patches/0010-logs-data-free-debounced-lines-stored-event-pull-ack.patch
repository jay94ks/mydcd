+		_ = q.Close()
+		return nil, err
+	}
+	if n := Notify; n != nil {
+		id := info.ContainerID
+		q.OnData = func(seq uint64) { n(id, seq) }
+	}
 	liveMu.Lock()
 	live[info.ContainerID] = q
 	liveMu.Unlock()
@@ -102,3 +142,6 @@ func lookup(id string) *Queue {
 	defer liveMu.Unlock()
 	return live[id]
 }
