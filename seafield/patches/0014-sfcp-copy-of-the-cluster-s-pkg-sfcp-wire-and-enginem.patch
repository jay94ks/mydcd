--- /dev/null
+++ b/daemon/seafield/sfcp/enginemux/mux.go
@@ -0,0 +1,639 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// Package enginemux carries many SFCP streams over one local unix
+// connection between sfcd and the Seafield engine (/run/sfe/sfcd.sock).
+// QUIC gives every other SFCP session its streams; here this package does.
+//
+// There is no second framing layer. Every byte on the connection is a SFCP
+// frame (pkg/sfcp/wire), and a frame belongs to the stream whose ID is its
+// request ID. Streams the listener opens have odd IDs, streams the dialer
+// opens have even IDs. Two header bytes that are reserved (zero) on every
+// other connection are used here:
+//
+//	byte 8: number of file descriptors sent with this frame (0..MaxFDs),
+//	        passed as SCM_RIGHTS on the sendmsg that carries its first byte
+//	byte 9: flags; FlagFIN ends the sender's direction, FlagRST resets
+//	        the stream
+//
+// Purpose 47 is this package's own: kind 1 returns receive window (field 1,
+// u32 little endian), kind 2 is an empty frame that carries only flags.
+// Readers of a Stream see the frames with bytes 8 and 9 zeroed, so the usual
+// wire.Rules checks apply unchanged; purpose 47 frames are never delivered.
+//
+// Flow control: each direction of each stream may have Window frame bytes
+// (headers included) unread; the reader returns window as its consumer reads.
+//
+// The package imports the standard library, this module's wire package and,
+// for the peer check only, golang.org/x/sys/unix (vendored by Moby too), so
+// the engine can keep a byte-identical copy.
+package enginemux
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/moby/moby/v2/daemon/seafield/sfcp/wire"
+)
+
+const (
+	// Control is the purpose of this package's own frames.
+	Control wire.Purpose = 47
+	// Window is the per-stream, per-direction budget of unread frame bytes
+	// (headers included): one largest frame.
+	Window = wire.HeaderSize + wire.MaxBody
+	// MaxFDs is the most descriptors one frame may carry.
+	MaxFDs  = 4
+	FlagFIN = 1
+	FlagRST = 2
+
+	kindWindow = 1
+	kindFlags  = 2
+	maxStreams = 256
+)
+
+var (
+	ErrClosed  = errors.New("engine mux closed")
+	ErrReset   = errors.New("engine mux stream reset")
+	ErrTimeout = os.ErrDeadlineExceeded
+	ErrProto   = errors.New("engine mux protocol violation")
+)
+
+type outgoing struct {
+	b   []byte
+	fds []int
+}
+
+// Session is one multiplexed connection.
+type Session struct {
+	conn     net.Conn
+	unixConn *net.UnixConn
+	listener bool
+
+	mu      sync.Mutex
+	streams map[uint64]*Stream
+	next    uint64
+	accept  chan *Stream
+	err     error
+	done    chan struct{}
+
+	out      chan outgoing
+	pending  []int // received descriptors not yet matched to a frame
+	closeOne sync.Once
+}
+
+// Server wraps the connection a listener accepted; Client wraps a dialed one.
+func Server(c net.Conn) *Session { return newSession(c, true) }
+func Client(c net.Conn) *Session { return newSession(c, false) }
+
+func newSession(c net.Conn, listener bool) *Session {
+	s := &Session{conn: c, listener: listener, streams: map[uint64]*Stream{}, accept: make(chan *Stream, 16), done: make(chan struct{}), out: make(chan outgoing, 64)}
+	s.unixConn, _ = c.(*net.UnixConn)
+	s.next = 2
+	if listener {
+		s.next = 1
+	}
+	go s.readLoop()
+	go s.writeLoop()
+	return s
+}
+
+// Done is closed when the session ends; Err then says why.
+func (s *Session) Done() <-chan struct{} { return s.done }
+
+func (s *Session) Err() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.err
+}
+
+// Close ends the session and every stream.
+func (s *Session) Close() error {
+	s.fail(ErrClosed)
+	return nil
+}
+
+func (s *Session) fail(err error) {
+	s.closeOne.Do(func() {
+		s.mu.Lock()
+		s.err = err
+		streams := s.streams
+		s.streams = map[uint64]*Stream{}
+		pending := s.pending
+		s.pending = nil
+		s.mu.Unlock()
+		close(s.done)
+		_ = s.conn.Close()
+		for _, st := range streams {
+			st.broken(err)
+		}
+		closeFDs(pending)
+	})
+}
+
+// Open starts a stream; its ID is the request ID every frame on it carries.
+func (s *Session) Open() (*Stream, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.err != nil {
+		return nil, s.err
+	}
+	if len(s.streams) >= maxStreams {
+		return nil, ErrProto
+	}
+	id := s.next
+	s.next += 2
+	st := newStream(s, id)
+	s.streams[id] = st
+	return st, nil
+}
+
+// Accept returns the next stream the peer opened.
+func (s *Session) Accept() (*Stream, error) {
+	select {
+	case st := <-s.accept:
+		return st, nil
+	case <-s.done:
+		return nil, s.Err()
+	}
+}
+
+func (s *Session) ours(id uint64) bool { return id%2 == 1 == s.listener }
+
+func (s *Session) send(o outgoing) error {
+	select {
+	case s.out <- o:
+		return nil
+	case <-s.done:
+		closeFDs(o.fds)
+		return s.Err()
+	}
+}
+
+func (s *Session) writeLoop() {
+	for {
+		select {
+		case o := <-s.out:
+			if err := s.write(o); err != nil {
+				s.fail(err)
+				return
+			}
+		case <-s.done:
+			return
+		}
+	}
+}
+
+func (s *Session) write(o outgoing) error {
+	b := o.b
+	if len(o.fds) > 0 {
+		if s.unixConn == nil {
+			return ErrProto
+		}
+		n, _, err := s.unixConn.WriteMsgUnix(b, syscall.UnixRights(o.fds...), nil)
+		closeFDs(o.fds) // the kernel holds its own references now
+		if err != nil {
+			return err
+		}
+		b = b[n:]
+	}
+	for len(b) > 0 {
+		n, err := s.conn.Write(b)
+		if err != nil {
+			return err
+		}
+		b = b[n:]
+	}
+	return nil
+}
+
+func control(id uint64, kind uint8, flags byte, value []byte) []byte {
+	b := make([]byte, wire.HeaderSize, wire.HeaderSize+8+len(value))
+	copy(b, "MDG1")
+	binary.LittleEndian.PutUint16(b[4:], 1)
+	b[6], b[7], b[9] = byte(Control), kind, flags
+	binary.LittleEndian.PutUint64(b[12:], id)
+	if value != nil {
+		b = binary.LittleEndian.AppendUint16(b, 1)
+		b = binary.LittleEndian.AppendUint16(b, 1)
+		b = binary.LittleEndian.AppendUint32(b, uint32(len(value)))
+		b = append(b, value...)
+	}
+	binary.LittleEndian.PutUint32(b[20:], uint32(len(b)-wire.HeaderSize))
+	return b
+}
+
+// reader collects bytes and, on a unix connection, the descriptors that
+// arrive with them, in order.
+type reader struct {
+	s   *Session
+	buf []byte
+	oob []byte
+}
+
+func (r *reader) fill(need int) error {
+	for len(r.buf) < need {
+		chunk := make([]byte, max(need-len(r.buf), 64<<10))
+		var n int
+		var err error
+		if r.s.unixConn != nil {
+			var oobn int
+			n, oobn, _, _, err = r.s.unixConn.ReadMsgUnix(chunk, r.oob)
+			if oobn > 0 {
+				if e := r.s.takeRights(r.oob[:oobn]); e != nil {
+					return e
+				}
+			}
+		} else {
+			n, err = r.s.conn.Read(chunk)
+		}
+		r.buf = append(r.buf, chunk[:max(n, 0)]...)
+		if err != nil {
+			if err == io.EOF && len(r.buf) >= need {
+				return nil
+			}
+			return err
+		}
+	}
+	return nil
+}
+
+func (s *Session) takeRights(oob []byte) error {
+	msgs, err := syscall.ParseSocketControlMessage(oob)
+	if err != nil {
+		return err
+	}
+	for _, m := range msgs {
+		fds, err := syscall.ParseUnixRights(&m)
+		if err != nil {
+			return err
+		}
+		s.mu.Lock()
+		s.pending = append(s.pending, fds...)
+		over := len(s.pending) > 4*MaxFDs
+		s.mu.Unlock()
+		if over {
+			return ErrProto
+		}
+	}
+	return nil
+}
+
+func (s *Session) readLoop() {
+	r := &reader{s: s, oob: make([]byte, syscall.CmsgSpace(4*MaxFDs*4))}
+	for {
+		if err := r.fill(wire.HeaderSize); err != nil {
+			s.fail(err)
+			return
+		}
+		h := r.buf[:wire.HeaderSize]
+		n := int(binary.LittleEndian.Uint32(h[20:24]))
+		if string(h[:4]) != "MDG1" || binary.LittleEndian.Uint16(h[4:6]) != 1 || h[8] > MaxFDs || h[9]&^(FlagFIN|FlagRST) != 0 || h[10] != 0 || h[11] != 0 || n > wire.MaxBody {
+			s.fail(ErrProto)
+			return
+		}
+		if err := r.fill(wire.HeaderSize + n); err != nil {
+			s.fail(err)
+			return
+		}
+		frame := r.buf[: wire.HeaderSize+n : wire.HeaderSize+n]
+		r.buf = append([]byte(nil), r.buf[wire.HeaderSize+n:]...)
+		if err := s.dispatch(frame); err != nil {
+			s.fail(err)
+			return
+		}
+	}
+}
+
+func (s *Session) dispatch(frame []byte) error {
+	id := binary.LittleEndian.Uint64(frame[12:20])
+	count, flags := int(frame[8]), frame[9]
+	frame[8], frame[9] = 0, 0
+	s.mu.Lock()
+	if count > len(s.pending) {
+		s.mu.Unlock()
+		return ErrProto
+	}
+	fds := append([]int(nil), s.pending[:count]...)
+	s.pending = s.pending[count:]
+	st := s.streams[id]
+	if st == nil && id != 0 && !s.ours(id) && wire.Purpose(frame[6]) != Control {
+		if len(s.streams) >= maxStreams {
+			s.mu.Unlock()
+			closeFDs(fds)
+			return ErrProto
+		}
+		st = newStream(s, id)
+		s.streams[id] = st
+		s.mu.Unlock()
+		select {
+		case s.accept <- st:
+		case <-s.done:
+			closeFDs(fds)
+			return ErrClosed
+		}
+	} else {
+		s.mu.Unlock()
+	}
+	if st == nil {
+		closeFDs(fds) // late frames of a finished stream
+		return nil
+	}
+	if wire.Purpose(frame[6]) == Control {
+		closeFDs(fds)
+		switch frame[7] {
+		case kindWindow:
+			if len(frame) != wire.HeaderSize+12 || binary.LittleEndian.Uint16(frame[24:]) != 1 || binary.LittleEndian.Uint32(frame[28:]) != 4 {
+				return ErrProto
+			}
+			st.credit(int(binary.LittleEndian.Uint32(frame[32:])))
+		case kindFlags:
+			if len(frame) != wire.HeaderSize {
+				return ErrProto
+			}
+		default:
+			return ErrProto
+		}
+		st.flags(flags)
+		return nil
+	}
+	if err := st.deliver(frame, fds); err != nil {
+		return err
+	}
+	st.flags(flags)
+	return nil
+}
+
+func (s *Session) forget(st *Stream) {
+	s.mu.Lock()
+	if s.streams[st.id] == st {
+		delete(s.streams, st.id)
+	}
+	s.mu.Unlock()
+}
+
+func closeFDs(fds []int) {
+	for _, fd := range fds {
+		_ = syscall.Close(fd)
+	}
+}
+
+// Stream is one SFCP stream. It is used like a QUIC stream: whole frames
+// are written with wire's WriteFrame and read with ReadFrame.
+type Stream struct {
+	s  *Session
+	id uint64
+
+	mu        sync.Mutex
+	cond      *sync.Cond
+	in        []byte // whole frames, flags zeroed
+	inFDs     []int
+	unacked   int // body bytes read but not yet returned as window
+	peerFIN   bool
+	sentFIN   bool
+	err       error // reset or session failure
+	sendRoom  int   // frame bytes the peer still accepts
+	partial   []byte
+	attach    []int
+	rDeadline time.Time
+	wDeadline time.Time
+	timer     *time.Timer
+}
+
+func newStream(s *Session, id uint64) *Stream {
+	st := &Stream{s: s, id: id, sendRoom: Window}
+	st.cond = sync.NewCond(&st.mu)
+	return st
+}
+
+// ID is the request ID every frame on this stream must carry.
+func (st *Stream) ID() uint64 { return st.id }
+
+func (st *Stream) broken(err error) {
+	st.mu.Lock()
+	if st.err == nil {
+		st.err = err
+	}
+	closeFDs(st.inFDs)
+	closeFDs(st.attach)
+	st.inFDs, st.attach = nil, nil
+	st.cond.Broadcast()
+	st.mu.Unlock()
+}
+
+func (st *Stream) credit(n int) {
+	st.mu.Lock()
+	st.sendRoom += n
+	st.cond.Broadcast()
+	st.mu.Unlock()
+}
+
+func (st *Stream) flags(f byte) {
+	if f&FlagRST != 0 {
+		st.broken(ErrReset)
+		st.s.forget(st)
+		return
+	}
+	if f&FlagFIN != 0 {
+		st.mu.Lock()
+		st.peerFIN = true
+		done := st.sentFIN
+		st.cond.Broadcast()
+		st.mu.Unlock()
+		if done {
+			st.s.forget(st)
+		}
+	}
+}
+
+func (st *Stream) deliver(frame []byte, fds []int) error {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	if st.peerFIN || len(st.in)+len(frame) > Window {
+		closeFDs(fds)
+		return ErrProto
+	}
+	if st.err != nil {
+		closeFDs(fds)
+		return nil
+	}
+	st.in = append(st.in, frame...)
+	st.inFDs = append(st.inFDs, fds...)
+	st.cond.Broadcast()
+	return nil
+}
+
+func (st *Stream) wait(deadline time.Time) {
+	if !deadline.IsZero() {
+		d := time.Until(deadline)
+		if d <= 0 {
+			return
+		}
+		t := time.AfterFunc(d, func() { st.mu.Lock(); st.cond.Broadcast(); st.mu.Unlock() })
+		defer t.Stop()
+	}
+	st.cond.Wait()
+}
+
+func expired(t time.Time) bool { return !t.IsZero() && !time.Now().Before(t) }
+
+// Read returns frame bytes in order; io.EOF after the peer's FIN.
+func (st *Stream) Read(p []byte) (int, error) {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	for len(st.in) == 0 {
+		switch {
+		case st.err != nil:
+			return 0, st.err
+		case st.peerFIN:
+			return 0, io.EOF
+		case expired(st.rDeadline):
+			return 0, ErrTimeout
+		}
+		st.wait(st.rDeadline)
+	}
+	n := copy(p, st.in)
+	st.in = st.in[n:]
+	st.unacked += n
+	if st.unacked >= Window/4 || len(st.in) == 0 {
+		var v [4]byte
+		binary.LittleEndian.PutUint32(v[:], uint32(st.unacked))
+		st.unacked = 0
+		go func() { _ = st.s.send(outgoing{b: control(st.id, kindWindow, 0, v[:])}) }()
+	}
+	return n, nil
+}
+
+// TakeFDs returns, in arrival order, the descriptors that came with frames
+// read so far or queued; the caller owns them.
+func (st *Stream) TakeFDs() []int {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	fds := st.inFDs
+	st.inFDs = nil
+	return fds
+}
+
+// Attach queues descriptors for the next frame written; the stream owns them
+// from now on and closes them after sending or on failure.
+func (st *Stream) Attach(fds ...int) error {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	if len(st.attach)+len(fds) > MaxFDs || st.s.unixConn == nil {
+		closeFDs(fds)
+		return ErrProto
+	}
+	st.attach = append(st.attach, fds...)
+	return nil
+}
+
+// Write takes whole frames (partial frames are held until complete); each
+// frame's request ID must be this stream's ID.
+func (st *Stream) Write(p []byte) (int, error) {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	if st.sentFIN {
+		return 0, ErrClosed
+	}
+	st.partial = append(st.partial, p...)
+	for len(st.partial) >= wire.HeaderSize {
+		h := st.partial[:wire.HeaderSize]
+		n := int(binary.LittleEndian.Uint32(h[20:24]))
+		if string(h[:4]) != "MDG1" || n > wire.MaxBody || binary.LittleEndian.Uint64(h[12:20]) != st.id || wire.Purpose(h[6]) == Control || h[8] != 0 || h[9] != 0 {
+			st.partial = nil
+			return 0, ErrProto
+		}
+		if len(st.partial) < wire.HeaderSize+n {
+			break
+		}
+		size := wire.HeaderSize + n
+		for st.sendRoom < size {
+			switch {
+			case st.err != nil:
+				return 0, st.err
+			case expired(st.wDeadline):
+				return 0, ErrTimeout
+			}
+			st.wait(st.wDeadline)
+		}
+		if st.err != nil {
+			return 0, st.err
+		}
+		frame := append([]byte(nil), st.partial[:size]...)
+		st.partial = st.partial[size:]
+		frame[8] = byte(len(st.attach))
+		fds := st.attach
+		st.attach = nil
+		st.sendRoom -= size
+		st.mu.Unlock()
+		err := st.s.send(outgoing{b: frame, fds: fds})
+		st.mu.Lock()
+		if err != nil {
+			return 0, err
+		}
+	}
+	return len(p), nil
+}
+
+// Close ends this side's direction (FIN). Reading continues until the peer's.
+func (st *Stream) Close() error {
+	st.mu.Lock()
+	if st.sentFIN || st.err != nil {
+		st.mu.Unlock()
+		return nil
+	}
+	st.sentFIN = true
+	done := st.peerFIN
+	st.mu.Unlock()
+	err := st.s.send(outgoing{b: control(st.id, kindFlags, FlagFIN, nil)})
+	if done {
+		st.s.forget(st)
+	}
+	return err
+}
+
+// CancelRead and CancelWrite reset the whole stream (RST); the code is not
+// carried.
+func (st *Stream) CancelRead(uint64)  { st.reset() }
+func (st *Stream) CancelWrite(uint64) { st.reset() }
+
+func (st *Stream) reset() {
+	st.mu.Lock()
+	if st.err != nil {
+		st.mu.Unlock()
+		return
+	}
+	st.mu.Unlock()
+	st.broken(ErrReset)
+	st.s.forget(st)
+	_ = st.s.send(outgoing{b: control(st.id, kindFlags, FlagRST, nil)})
+}
+
+func (st *Stream) SetDeadline(t time.Time) error {
+	st.mu.Lock()
+	st.rDeadline, st.wDeadline = t, t
+	st.cond.Broadcast()
+	st.mu.Unlock()
+	return nil
+}
+
+func (st *Stream) SetReadDeadline(t time.Time) error {
+	st.mu.Lock()
+	st.rDeadline = t
+	st.cond.Broadcast()
+	st.mu.Unlock()
+	return nil
+}
+
+func (st *Stream) SetWriteDeadline(t time.Time) error {
+	st.mu.Lock()
+	st.wDeadline = t
+	st.cond.Broadcast()
+	st.mu.Unlock()
+	return nil
+}
diff --git a/daemon/seafield/sfcp/enginemux/mux_test.go b/daemon/seafield/sfcp/enginemux/mux_test.go
new file mode 100644
index 0000000..cf64ed1
--- /dev/null
+++ b/daemon/seafield/sfcp/enginemux/mux_test.go
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package enginemux
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/moby/moby/v2/daemon/seafield/sfcp/wire"
+)
+
+var rules = wire.Rules(func(p wire.Purpose, kind uint8) (wire.Rule, bool) {
+	if p == 32 && (kind == 1 || kind == 2) {
+		return wire.Rule{Fields: []int{-1}, Budget: wire.MaxBody}, true
+	}
+	return wire.Rule{}, false
+})
+
+func pair(t *testing.T) (*Session, *Session) {
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn := func(fd int) net.Conn {
+		f := os.NewFile(uintptr(fd), "mux")
+		c, err := net.FileConn(f)
+		_ = f.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return c
+	}
+	server, client := Server(conn(fds[0])), Client(conn(fds[1]))
+	t.Cleanup(func() { _ = server.Close(); _ = client.Close() })
+	return server, client
+}
+
+func frame(id uint64, kind uint8, body []byte) wire.Frame {
+	return wire.Frame{Purpose: 32, Kind: kind, Request: id, Fields: []wire.Field{{Tag: 1, Required: true, Value: body}}}
+}
+
+func TestCallsBothWays(t *testing.T) {
+	server, client := pair(t)
+	serve := func(s *Session) {
+		for {
+			st, err := s.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				f, err := rules.ReadFrame(st, wire.MaxBody)
+				if err != nil {
+					return
+				}
+				_ = rules.WriteFrame(st, frame(st.ID(), 2, append([]byte("re:"), f.Fields[0].Value...)))
+				_ = st.Close()
+			}()
+		}
+	}
+	go serve(server)
+	go serve(client)
+	call := func(s *Session, msg string) {
+		st, err := s.Open()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = rules.WriteFrame(st, frame(st.ID(), 1, []byte(msg))); err != nil {
+			t.Fatal(err)
+		}
+		_ = st.Close()
+		f, err := rules.ReadFrame(st, wire.MaxBody)
+		if err != nil || f.Request != st.ID() || string(f.Fields[0].Value) != "re:"+msg {
+			t.Fatal(f, err)
+		}
+		if _, err = st.Read(make([]byte, 1)); err != io.EOF {
+			t.Fatal("no EOF after reply", err)
+		}
+	}
+	for range 3 {
+		call(client, "from dialer")
+		call(server, "from listener")
+	}
+	a, _ := client.Open()
+	b, _ := server.Open()
+	if a.ID()%2 != 0 || b.ID()%2 != 1 {
+		t.Fatal("stream ID parity", a.ID(), b.ID())
+	}
+}
+
+// Large frames pass one window at a time and stay in order; another stream
+// is not blocked by an unread one.
+func TestWindowAndIndependentStreams(t *testing.T) {
+	server, client := pair(t)
+	slow, _ := client.Open()
+	payload := bytes.Repeat([]byte{7}, wire.MaxBody-8)
+	done := make(chan error, 1)
+	go func() {
+		for i := range 4 {
+			payload[0] = byte(i)
+			if err := rules.WriteFrame(slow, frame(slow.ID(), 1, payload)); err != nil {
+				done <- err
+				return
+			}
+		}
+		done <- slow.Close()
+	}()
+	in, err := server.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	fast, _ := client.Open()
+	if err = rules.WriteFrame(fast, frame(fast.ID(), 1, []byte("quick"))); err != nil {
+		t.Fatal(err)
+	}
+	other, err := server.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if f, err := rules.ReadFrame(other, wire.MaxBody); err != nil || string(f.Fields[0].Value) != "quick" {
+		t.Fatal("second stream blocked", err)
+	}
+	for i := range 4 {
+		f, err := rules.ReadFrame(in, wire.MaxBody)
+		if err != nil || f.Fields[0].Value[0] != byte(i) || len(f.Fields[0].Value) != len(payload) {
+			t.Fatal(i, err)
+		}
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDescriptorsResetAndChecks(t *testing.T) {
+	server, client := pair(t)
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	st, _ := client.Open()
+	dup, _ := syscall.Dup(int(w.Fd()))
+	_ = w.Close()
+	if err = st.Attach(dup); err != nil {
+		t.Fatal(err)
+	}
+	if err = rules.WriteFrame(st, frame(st.ID(), 1, []byte("fd"))); err != nil {
+		t.Fatal(err)
+	}
+	in, _ := server.Accept()
+	if _, err = rules.ReadFrame(in, wire.MaxBody); err != nil {
+		t.Fatal(err)
+	}
+	fds := in.TakeFDs()
+	if len(fds) != 1 {
+		t.Fatal("fds", fds)
+	}
+	got := os.NewFile(uintptr(fds[0]), "w")
+	_, _ = got.Write([]byte("ok"))
+	_ = got.Close()
+	buf := make([]byte, 2)
+	if _, err = io.ReadFull(r, buf); err != nil || string(buf) != "ok" {
+		t.Fatal("descriptor not usable", err)
+	}
+
+	// A reset reaches the other side.
+	in.CancelRead(0)
+	_ = st.SetReadDeadline(time.Now().Add(2 * time.Second))
+	if _, err = st.Read(make([]byte, 1)); !errors.Is(err, ErrReset) {
+		t.Fatal("reset not seen", err)
+	}
+
+	// A frame must carry its stream's request ID; deadlines apply.
+	wrong, _ := client.Open()
+	if err = rules.WriteFrame(wrong, frame(wrong.ID()+2, 1, []byte("x"))); !errors.Is(err, ErrProto) {
+		t.Fatal("foreign request ID accepted", err)
+	}
+	_ = wrong.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+	if _, err = wrong.Read(make([]byte, 1)); !errors.Is(err, ErrTimeout) {
+		t.Fatal("deadline", err)
+	}
+	var many []int
+	for range 5 {
+		fd, _ := syscall.Dup(int(r.Fd()))
+		many = append(many, fd)
+	}
+	if err = wrong.Attach(many...); err == nil {
+		t.Fatal("too many descriptors accepted")
+	}
+	// Attach closed the refused descriptors itself.
+}
+
+func TestPeerCloseEndsStreams(t *testing.T) {
+	server, client := pair(t)
+	st, _ := client.Open()
+	_ = rules.WriteFrame(st, frame(st.ID(), 1, []byte("x")))
+	if _, err := server.Accept(); err != nil {
+		t.Fatal(err)
+	}
+	_ = server.Close()
+	_ = st.SetReadDeadline(time.Now().Add(2 * time.Second))
+	if _, err := st.Read(make([]byte, 1)); err == nil || errors.Is(err, ErrTimeout) {
+		t.Fatal("stream outlived its session", err)
+	}
+	select {
+	case <-client.Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("client session not ended")
+	}
+}
+
+func TestInstalled(t *testing.T) {
+	if !Installed("/usr/lib/sfc/bin/sfed", "sfed") || !Installed("/usr/local/bin/sfcd", "sfcd") {
+		t.Fatal("installed path refused")
+	}
+	for _, exe := range []string{"/tmp/sfed", "/usr/lib/sfc/bin/sfed (deleted)", "/usr/lib/sfc/bin/sub/sfed"} {
+		if Installed(exe, "sfed") {
+			t.Fatal("accepted", exe)
+		}
+	}
+	if Installed("/usr/local/bin/x", "../x") {
+		t.Fatal("name with a path accepted")
+	}
+}
+
+// The check runs against a real peer: this test process is not an installed
+// sfed, so it is refused whether or not the kernel offers SO_PEERPIDFD.
+func TestCheckPeerRefusesUninstalledBinary(t *testing.T) {
+	fds, err := syscall.Socketpair(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := os.NewFile(uintptr(fds[0]), "a")
+	c, err := net.FileConn(f)
+	_ = f.Close()
+	defer syscall.Close(fds[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if err := CheckPeer(c.(*net.UnixConn), "sfed"); !errors.Is(err, ErrPeer) {
+		t.Fatal("uninstalled peer admitted", err)
+	}
+}
diff --git a/daemon/seafield/sfcp/enginemux/peercheck_linux.go b/daemon/seafield/sfcp/enginemux/peercheck_linux.go
new file mode 100644
index 0000000..f609738
--- /dev/null
+++ b/daemon/seafield/sfcp/enginemux/peercheck_linux.go
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package enginemux
+
+import (
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+
+	"golang.org/x/sys/unix"
+)
+
+// soPeerPIDFD is SO_PEERPIDFD (Linux 6.5+; Ubuntu 24.04 ships 6.8).
+const soPeerPIDFD = 77
+
+// InstallDirs are where packaged sfc binaries may live.
+var InstallDirs = []string{"/usr/lib/sfc/bin", "/usr/local/lib/sfc/bin", "/usr/local/bin"}
+
+var ErrPeer = errors.New("engine socket peer is not the expected root process")
+
+// CheckPeer admits the process at the other end of c only when it runs as
+// root and its executable is name in one of InstallDirs. The process is
+// pinned with a pidfd before its executable is read and must still be alive
+// afterwards, so a recycled PID cannot pass as it. No key or nonce is
+// exchanged: only root can open these 0600 root-owned sockets, and root can
+// read any key file anyway.
+func CheckPeer(c *net.UnixConn, name string) error {
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var cred *unix.Ucred
+	var pidfd int
+	var credErr, pidErr error
+	if err = raw.Control(func(fd uintptr) {
+		cred, credErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+		pidfd, pidErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, soPeerPIDFD)
+	}); err != nil {
+		return err
+	}
+	if credErr != nil || pidErr != nil {
+		return errors.Join(ErrPeer, credErr, pidErr)
+	}
+	defer unix.Close(pidfd)
+	if cred.Uid != 0 || cred.Pid <= 0 {
+		return ErrPeer
+	}
+	exe, err := os.Readlink("/proc/" + strconv.Itoa(int(cred.Pid)) + "/exe")
+	if err != nil {
+		return errors.Join(ErrPeer, err)
+	}
+	// The pinned process is still alive, so the PID was not reused between
+	// the credential read and the executable read.
+	if err = unix.PidfdSendSignal(pidfd, 0, nil, 0); err != nil {
+		return errors.Join(ErrPeer, err)
+	}
+	if !Installed(exe, name) {
+		return ErrPeer
+	}
+	return nil
+}
+
+// Installed reports whether exe is name in one of InstallDirs.
+func Installed(exe, name string) bool {
+	if name == "" || filepath.Base(name) != name {
+		return false
+	}
+	for _, dir := range InstallDirs {
+		if exe == filepath.Join(dir, name) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/daemon/seafield/sfcp/wire/wire.go b/daemon/seafield/sfcp/wire/wire.go
new file mode 100644
index 0000000..4b68d86
--- /dev/null
+++ b/daemon/seafield/sfcp/wire/wire.go
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// Package wire is the SFCP frame codec: the 24-byte header, the TLV body and
+// the per-purpose/kind field rules a caller supplies. It imports only the
+// standard library, so a program outside this module (the Seafield engine)
+// can keep a byte-identical copy and speak the same frames.
+//
+// Header (little endian): "MDG1" | schema u16 = 1 | purpose u8 | kind u8 |
+// reserved u32 = 0 | request u64 | body length u32. Body: fields of
+// tag u16 | flags u16 (1 = required) | length u32 | value, tags ascending.
+// Tags 1..len(Rule.Fields) are the required fields of that kind, in order;
+// tags >= 128 are optional extensions; nothing else is accepted.
+package wire
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+)
+
+const HeaderSize = 24
+const MaxBody = 256 << 10
+
+var (
+	ErrFrame     = errors.New("invalid SFCP frame")
+	ErrBudget    = errors.New("SFCP frame budget exceeded")
+	ErrTruncated = errors.New("truncated SFCP frame")
+)
+
+type Purpose uint8
+
+type Field struct {
+	Tag      uint16
+	Required bool
+	Value    []byte
+}
+
+type Frame struct {
+	Purpose Purpose
+	Kind    uint8
+	Request uint64
+	Fields  []Field
+}
+
+// Rule is what the codec checks for one purpose/kind. Fields holds the exact
+// length of each required field, -1 for any non-zero length. Budget is the
+// largest body; zero means the purpose/kind is unknown. NoRequest marks a
+// datagram purpose whose request ID is always zero (every other purpose's is
+// never zero).
+type Rule struct {
+	Fields    []int
+	Budget    int
+	NoRequest bool
+}
+
+// Rules looks up the rule of a purpose/kind; ok false means unknown.
+type Rules func(p Purpose, kind uint8) (r Rule, ok bool)
+
+func (rules Rules) header(h []byte, limit int) (Frame, Rule, int, error) {
+	if string(h[:4]) != "MDG1" || binary.LittleEndian.Uint16(h[4:6]) != 1 || binary.LittleEndian.Uint32(h[8:12]) != 0 {
+		return Frame{}, Rule{}, 0, ErrFrame
+	}
+	f := Frame{Purpose: Purpose(h[6]), Kind: h[7], Request: binary.LittleEndian.Uint64(h[12:20])}
+	r, ok := rules(f.Purpose, f.Kind)
+	n := uint64(binary.LittleEndian.Uint32(h[20:24]))
+	if !ok || r.Budget <= 0 || (f.Request == 0) != r.NoRequest {
+		return Frame{}, Rule{}, 0, ErrFrame
+	}
+	if n > uint64(r.Budget) || n > uint64(limit) {
+		return Frame{}, Rule{}, 0, ErrBudget
+	}
+	return f, r, int(n), nil
+}
+
+func parseFields(f Frame, rule Rule, b []byte) (Frame, error) {
+	rules := rule.Fields
+	previous := uint16(0)
+	for len(b) > 0 {
+		if len(b) < 8 {
+			return Frame{}, ErrFrame
+		}
+		tag, flags := binary.LittleEndian.Uint16(b), binary.LittleEndian.Uint16(b[2:])
+		n := uint64(binary.LittleEndian.Uint32(b[4:]))
+		b = b[8:]
+		if tag <= previous || flags > 1 || n > uint64(len(b)) || len(f.Fields) >= 32 {
+			return Frame{}, ErrFrame
+		}
+		previous = tag
+		if int(tag) <= len(rules) {
+			want := rules[tag-1]
+			if flags != 1 || n == 0 || want >= 0 && n != uint64(want) {
+				return Frame{}, ErrFrame
+			}
+		} else if tag < 128 || flags != 0 {
+			return Frame{}, ErrFrame
+		}
+		f.Fields = append(f.Fields, Field{tag, flags == 1, b[:int(n)]})
+		b = b[int(n):]
+	}
+	if len(f.Fields) < len(rules) {
+		return Frame{}, ErrFrame
+	}
+	for i := range rules {
+		if f.Fields[i].Tag != uint16(i+1) {
+			return Frame{}, ErrFrame
+		}
+	}
+	return f, nil
+}
+
+// Encode returns the bytes of f after checking them as a receiver would.
+func (rules Rules) Encode(f Frame) ([]byte, error) {
+	b := make([]byte, HeaderSize)
+	copy(b, "MDG1")
+	binary.LittleEndian.PutUint16(b[4:], 1)
+	b[6] = byte(f.Purpose)
+	b[7] = f.Kind
+	binary.LittleEndian.PutUint64(b[12:], f.Request)
+	for _, field := range f.Fields {
+		if len(field.Value) > MaxBody || len(b)+8+len(field.Value) > HeaderSize+MaxBody {
+			return nil, ErrBudget
+		}
+		b = binary.LittleEndian.AppendUint16(b, field.Tag)
+		flags := uint16(0)
+		if field.Required {
+			flags = 1
+		}
+		b = binary.LittleEndian.AppendUint16(b, flags)
+		b = binary.LittleEndian.AppendUint32(b, uint32(len(field.Value)))
+		b = append(b, field.Value...)
+	}
+	binary.LittleEndian.PutUint32(b[20:], uint32(len(b)-HeaderSize))
+	_, rule, _, err := rules.header(b[:HeaderSize], MaxBody)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := parseFields(Frame{Purpose: f.Purpose, Kind: f.Kind}, rule, b[HeaderSize:]); err != nil {
+		return nil, err
+	}
+	return b, nil
+}
+
+// ReadFrame reads one frame whose body is at most limit bytes.
+func (rules Rules) ReadFrame(r io.Reader, limit int) (Frame, error) {
+	var header [HeaderSize]byte
+	if _, err := io.ReadFull(r, header[:]); err != nil {
+		return Frame{}, err
+	}
+	f, rule, n, err := rules.header(header[:], limit)
+	if err != nil {
+		return Frame{}, err
+	}
+	body := make([]byte, n)
+	if _, err := io.ReadFull(r, body); err != nil {
+		return Frame{}, err
+	}
+	return parseFields(f, rule, body)
+}
+
+// WriteFrame encodes f and writes all of it.
+func (rules Rules) WriteFrame(w io.Writer, f Frame) error {
+	b, err := rules.Encode(f)
+	if err != nil {
+		return err
+	}
+	for len(b) > 0 {
+		n, err := w.Write(b)
+		if err != nil {
+			return err
+		}
+		if n <= 0 {
+			return io.ErrShortWrite
+		}
+		b = b[n:]
+	}
+	return nil
+}
+
+// Decoder consumes at most one frame per Feed. The owner controls queued item
+// count/deadline separately. Bad input poisons the stream; never resynchronize.
+type Decoder struct {
+	rules          Rules
+	header         [HeaderSize]byte
+	hn             int
+	body           []byte
+	bn             int
+	frame          Frame
+	rule           Rule
+	limit          int
+	failed, closed bool
+}
+
+func (rules Rules) NewDecoder(limit int) (*Decoder, error) {
+	if limit <= 0 || limit > MaxBody {
+		return nil, ErrBudget
+	}
+	return &Decoder{rules: rules, limit: limit}, nil
+}
+
+func (d *Decoder) Buffered() int { return d.hn + len(d.body) }
+
+func (d *Decoder) Feed(p []byte) (*Frame, int, error) {
+	if d.failed || d.closed {
+		return nil, 0, ErrFrame
+	}
+	used := 0
+	if d.hn < HeaderSize {
+		n := copy(d.header[d.hn:], p)
+		d.hn += n
+		used += n
+		p = p[n:]
+		if d.hn < HeaderSize {
+			return nil, used, nil
+		}
+		f, rule, n, err := d.rules.header(d.header[:], d.limit)
+		if err != nil {
+			d.failed = true
+			return nil, used, err
+		}
+		d.frame, d.rule = f, rule
+		d.body = make([]byte, n)
+	}
+	n := copy(d.body[d.bn:], p)
+	d.bn += n
+	used += n
+	if d.bn < len(d.body) {
+		return nil, used, nil
+	}
+	f, err := parseFields(d.frame, d.rule, d.body)
+	if err != nil {
+		d.failed = true
+		return nil, used, err
+	}
+	d.hn = 0
+	d.bn = 0
+	d.body = nil
+	return &f, used, nil
+}
+
+func (d *Decoder) Close() error {
+	d.closed = true
+	if d.failed {
+		return ErrFrame
+	}
+	if d.hn != 0 {
+		return ErrTruncated
+	}
+	return nil
+}
diff --git a/daemon/seafield/sfcp/wire/wire_test.go b/daemon/seafield/sfcp/wire/wire_test.go
new file mode 100644
index 0000000..044fe51
--- /dev/null
+++ b/daemon/seafield/sfcp/wire/wire_test.go
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package wire
+
+import (
+	"bytes"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+var testRules = Rules(func(p Purpose, kind uint8) (Rule, bool) {
+	switch {
+	case p == 1 && kind == 1:
+		return Rule{Fields: []int{-1, 4}, Budget: 64}, true
+	case p == 6 && kind == 1:
+		return Rule{Budget: 64, NoRequest: true}, true
+	}
+	return Rule{}, false
+})
+
+func TestRoundTripAndRules(t *testing.T) {
+	f := Frame{Purpose: 1, Kind: 1, Request: 7, Fields: []Field{{1, true, []byte("x")}, {2, true, []byte("abcd")}, {128, false, []byte("ext")}}}
+	var buf bytes.Buffer
+	if err := testRules.WriteFrame(&buf, f); err != nil {
+		t.Fatal(err)
+	}
+	got, err := testRules.ReadFrame(&buf, MaxBody)
+	if err != nil || got.Request != 7 || len(got.Fields) != 3 || string(got.Fields[2].Value) != "ext" {
+		t.Fatal(got, err)
+	}
+	for _, bad := range []Frame{
+		{Purpose: 1, Kind: 2, Request: 1},                                                                                       // unknown kind
+		{Purpose: 1, Kind: 1, Request: 0, Fields: f.Fields},                                                                     // missing request ID
+		{Purpose: 6, Kind: 1, Request: 1},                                                                                       // datagram with request ID
+		{Purpose: 1, Kind: 1, Request: 1, Fields: []Field{{1, true, []byte("x")}}},                                              // missing field
+		{Purpose: 1, Kind: 1, Request: 1, Fields: []Field{{1, true, []byte("x")}, {2, true, []byte("abc")}}},                    // wrong length
+		{Purpose: 1, Kind: 1, Request: 1, Fields: []Field{{1, true, bytes.Repeat([]byte("x"), 80)}, {2, true, []byte("abcd")}}}, // over budget
+	} {
+		if _, err := testRules.Encode(bad); err == nil {
+			t.Fatalf("encoded %+v", bad)
+		}
+	}
+	d, _ := testRules.NewDecoder(MaxBody)
+	b, _ := testRules.Encode(f)
+	for i := range b {
+		if fr, _, err := d.Feed(b[i : i+1]); err != nil || (fr != nil) != (i == len(b)-1) {
+			t.Fatal(i, fr, err)
+		}
+	}
+	if d.Close() != nil {
+		t.Fatal("clean close")
+	}
+}
+
+// The package must stay copyable into the engine: standard library only.
+func TestStandardLibraryOnly(t *testing.T) {
+	files, _ := filepath.Glob("*.go")
+	for _, name := range files {
+		src, err := os.ReadFile(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		f, err := parser.ParseFile(token.NewFileSet(), name, src, parser.ImportsOnly)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, imp := range f.Imports {
+			path, _ := strconv.Unquote(imp.Path.Value)
+			if strings.Contains(strings.SplitN(path, "/", 2)[0], ".") {
+				t.Fatalf("%s imports %s", name, path)
+			}
+		}
+	}
+}
