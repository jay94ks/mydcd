 		if fi, err := os.Stat(p); err == nil && fi.Mode()&os.ModeSocket != 0 {
diff --git a/pkg/plugins/seafield.go b/pkg/plugins/seafield.go
new file mode 100644
index 0000000..e120320
--- /dev/null
+++ b/pkg/plugins/seafield.go
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package plugins
+
+// legacyDisabled turns off v1 plugin discovery (/run/docker/plugins,
+// /etc/docker/plugins, /usr/lib/docker/plugins). Seafield has no plugins:
+// its volume, network and log needs are built in, and sharing Docker's
+// discovery directories would let a plugin meant for a Docker installed on
+// the same host attach to this engine.
+const legacyDisabled = true
diff --git a/pkg/plugins/seafield_test.go b/pkg/plugins/seafield_test.go
new file mode 100644
index 0000000..1e85f00
--- /dev/null
+++ b/pkg/plugins/seafield_test.go
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package plugins
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLegacyDiscoveryOff(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "evil.spec"), []byte("unix:///tmp/evil.sock"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	r := LocalRegistry{socketsPath: dir, specsPaths: []string{dir}}
+	if names, err := r.Scan(); err != nil || len(names) != 0 {
+		t.Fatalf("scan found %v %v", names, err)
+	}
+	if _, err := r.Plugin("evil"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("plugin lookup: %v", err)
+	}
+}
