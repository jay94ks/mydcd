diff --git a/daemon/seafield/logqueue/queue.go b/daemon/seafield/logqueue/queue.go
index cb8f26d..0328962 100644
--- a/daemon/seafield/logqueue/queue.go
+++ b/daemon/seafield/logqueue/queue.go
@@ -33,6 +33,24 @@ type Line struct {
 	Data    []byte    `json:"data"`
 }
 
+// AppendRecord appends l in the record encoding shared by segment files and
+// the bulk read: big-endian seq (8), unix nanoseconds (8), stream (1: 1
+// stdout, 2 stderr), partial (1), data length (4), then the data.
+func AppendRecord(b []byte, l Line) []byte {
+	var h [headerSize]byte
+	binary.BigEndian.PutUint64(h[0:], l.Seq)
+	binary.BigEndian.PutUint64(h[8:], uint64(l.Time.UnixNano()))
+	h[16] = 1
+	if l.Stream == "stderr" {
+		h[16] = 2
+	}
+	if l.Partial {
+		h[17] = 1
+	}
+	binary.BigEndian.PutUint32(h[18:], uint32(len(l.Data)))
+	return append(append(b, h[:]...), l.Data...)
+}
+
 // Gap is a range of numbers that is no longer in the queue.
 type Gap struct {
 	From uint64 `json:"from"`
@@ -172,19 +190,8 @@ func (q *Queue) Append(t time.Time, stream string, partial bool, data []byte) er
 			return err
 		}
 	}
-	var h [headerSize]byte
-	binary.BigEndian.PutUint64(h[0:], q.next)
-	binary.BigEndian.PutUint64(h[8:], uint64(t.UnixNano()))
-	if stream == "stderr" {
-		h[16] = 2
-	} else {
-		h[16] = 1
-	}
-	if partial {
-		h[17] = 1
-	}
-	binary.BigEndian.PutUint32(h[18:], uint32(len(data)))
-	if _, err := q.cur.Write(append(h[:], data...)); err != nil {
+	rec := AppendRecord(nil, Line{Seq: q.next, Time: t, Stream: stream, Partial: partial, Data: data})
+	if _, err := q.cur.Write(rec); err != nil {
 		return err
 	}
 	q.sizes[len(q.sizes)-1] += int64(headerSize + len(data))
