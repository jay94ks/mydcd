+const (
+	defaultBulk = 4 << 20
+	maxBulk     = 16 << 20
+)
+
+// get answers one bulk of records after `after`, in the segment record
+// encoding (AppendRecord), up to max_bytes (at least one record). There is
+// no per-line read and no waiting: the seafield.logs event says when to come.
 func (r qRouter) get(ctx context.Context, w http.ResponseWriter, req *http.Request, vars map[string]string) error {
 	id, err := r.resolve(vars["name"])
 	if err != nil {
@@ -61,34 +60,66 @@ func (r qRouter) get(ctx context.Context, w http.ResponseWriter, req *http.Reque
 	if err != nil {
 		return err
 	}
-	limit := 1000
-	if v := q.Get("limit"); v != "" {
+	limit := defaultBulk
+	if v := q.Get("max_bytes"); v != "" {
 		n, err := strconv.Atoi(v)
 		if err != nil || n <= 0 {
-			return errdefs.InvalidParameter(errors.New("limit must be a positive number"))
+			return errdefs.InvalidParameter(errors.New("max_bytes must be a positive number"))
 		}
-		limit = min(n, 10_000)
+		limit = min(n, maxBulk)
 	}
 	lq := lookup(id)
-	var (
-		lines []Line
-		gap   *Gap
-	)
-	if lq != nil {
-		lines, gap, _, err = lq.Read(after, limit)
-	} else {
-		lines, gap, err = ReadDir(Dir(id), after, limit)
+	read := func(after uint64) ([]Line, *Gap, error) {
+		if lq != nil {
+			l, g, _, err := lq.Read(after, 1000)
+			return l, g, err
+		}
+		l, g, err := ReadDir(Dir(id), after, 1000)
 		if errors.Is(err, os.ErrNotExist) {
 			err = nil
 		}
+		return l, g, err
 	}
+	var (
+		body        []byte
+		first, last uint64
+		count       int
+	)
+	lines, gap, err := read(after)
 	if err != nil {
 		return err
 	}
-	if lines == nil {
-		lines = []Line{}
+fill:
+	for len(lines) > 0 {
+		for _, l := range lines {
+			if count > 0 && len(body)+headerSize+len(l.Data) > limit {
+				break fill
+			}
+			body = AppendRecord(body, l)
+			if count == 0 {
+				first = l.Seq
+			}
+			last, count = l.Seq, count+1
+		}
+		if lines, _, err = read(last); err != nil {
+			return err
+		}
+	}
+	h := w.Header()
+	h.Set("Content-Type", "application/vnd.seafield.log-records")
+	h.Set("Seafield-Live", strconv.FormatBool(lq != nil))
+	h.Set("Seafield-Count", strconv.Itoa(count))
+	if count > 0 {
+		h.Set("Seafield-First", strconv.FormatUint(first, 10))
+		h.Set("Seafield-Last", strconv.FormatUint(last, 10))
+	}
+	if gap != nil {
+		h.Set("Seafield-Gap", strconv.FormatUint(gap.From, 10)+"-"+strconv.FormatUint(gap.To, 10))
 	}
-	return httputils.WriteJSON(w, http.StatusOK, Page{Gap: gap, Lines: lines, Live: lq != nil})
+	h.Set("Content-Length", strconv.Itoa(len(body)))
+	w.WriteHeader(http.StatusOK)
+	_, err = w.Write(body)
+	return err
