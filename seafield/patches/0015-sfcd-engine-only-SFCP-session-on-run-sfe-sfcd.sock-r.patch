diff --git a/daemon/seafield/logqueue/session.go b/daemon/seafield/logqueue/session.go
new file mode 100644
index 0000000..6660ad9
--- /dev/null
+++ b/daemon/seafield/logqueue/session.go
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package logqueue
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+
+	"github.com/moby/moby/v2/daemon/seafield/sfcd"
+)
+
+// ContainerResolver maps a name or id prefix to a full container id.
+type ContainerResolver func(nameOrID string) (string, error)
+
+// Purpose 33 EngineLog (bulk) and 34 EngineLogAck, asked by sfcd.
+type (
+	BulkQ struct {
+		sfcd.Request
+		Container string
+		After     uint64
+		MaxBytes  int
+	}
+	// Range is a run of numbers that are gone.
+	Range struct{ From, To uint64 }
+	// BulkA is followed by Size bytes of records in the segment record
+	// encoding (AppendRecord) as kind 4 chunks, then FIN.
+	BulkA struct {
+		sfcd.Reply
+		Count       int
+		First, Last uint64
+		Gap         *Range
+		Live        bool
+		Size        int
+	}
+	AckQ struct {
+		sfcd.Request
+		Container string
+		Upto      uint64
+	}
+)
+
+const (
+	defaultBulk = 4 << 20
+	maxBulk     = 16 << 20
+)
+
+func refuse(st *sfcd.Stream, opID, reason string) error {
+	return st.Answer(&sfcd.Reply{OpID: opID, Result: sfcd.NotApplied, Reason: reason})
+}
+
+// ServeBulk answers purpose 33: one bulk of records after After, up to
+// MaxBytes (at least one record). There is no per-line read and no waiting:
+// the seafield.logs event says when to come.
+func ServeBulk(resolve ContainerResolver) sfcd.Handler {
+	return func(ctx context.Context, st *sfcd.Stream, req sfcd.Request, body []byte) error {
+		var q BulkQ
+		if req.Op != "bulk" || json.Unmarshal(body, &q) != nil || q.MaxBytes < 0 {
+			return refuse(st, req.OpID, sfcd.Invalid)
+		}
+		id, err := resolve(q.Container)
+		if err != nil {
+			return refuse(st, req.OpID, sfcd.NotFound)
+		}
+		limit := defaultBulk
+		if q.MaxBytes > 0 {
+			limit = min(q.MaxBytes, maxBulk)
+		}
+		a, data, err := bulk(id, q.After, limit)
+		if err != nil {
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.Unknown})
+		}
+		a.OpID = req.OpID
+		if err := st.Answer(&a); err != nil {
+			return err
+		}
+		if _, err := st.Write(data); err != nil {
+			return err
+		}
+		return st.Done()
+	}
+}
+
+func bulk(id string, after uint64, limit int) (BulkA, []byte, error) {
+	lq := lookup(id)
+	read := func(after uint64) ([]Line, *Gap, error) {
+		if lq != nil {
+			l, g, _, err := lq.Read(after, 1000)
+			return l, g, err
+		}
+		l, g, err := ReadDir(Dir(id), after, 1000)
+		if errors.Is(err, os.ErrNotExist) {
+			err = nil
+		}
+		return l, g, err
+	}
+	a := BulkA{Live: lq != nil}
+	var body []byte
+	lines, gap, err := read(after)
+	if err != nil {
+		return a, nil, err
+	}
+	if gap != nil {
+		a.Gap = &Range{From: gap.From, To: gap.To}
+	}
+fill:
+	for len(lines) > 0 {
+		for _, l := range lines {
+			if a.Count > 0 && len(body)+headerSize+len(l.Data) > limit {
+				break fill
+			}
+			body = AppendRecord(body, l)
+			if a.Count == 0 {
+				a.First = l.Seq
+			}
+			a.Last, a.Count = l.Seq, a.Count+1
+		}
+		if lines, _, err = read(a.Last); err != nil {
+			return a, nil, err
+		}
+	}
+	a.Size = len(body)
+	return a, body, nil
+}
+
+// ServeAck answers purpose 34: records up to Upto were taken; the queue
+// deletes the segments they cover.
+func ServeAck(resolve ContainerResolver) sfcd.Handler {
+	return func(ctx context.Context, st *sfcd.Stream, req sfcd.Request, body []byte) error {
+		var q AckQ
+		if req.Op != "ack" || json.Unmarshal(body, &q) != nil {
+			return refuse(st, req.OpID, sfcd.Invalid)
+		}
+		id, err := resolve(q.Container)
+		if err != nil {
+			return refuse(st, req.OpID, sfcd.NotFound)
+		}
+		if lq := lookup(id); lq != nil {
+			lq.Ack(q.Upto)
+		} else if qq, err := Open(Dir(id), 0); err == nil {
+			qq.Ack(q.Upto)
+			_ = qq.Close()
+		}
+		return st.Answer(&sfcd.Reply{OpID: req.OpID})
+	}
+}
