diff --git a/daemon/seafield/eventfeed/session.go b/daemon/seafield/eventfeed/session.go
new file mode 100644
index 0000000..684af2b
--- /dev/null
+++ b/daemon/seafield/eventfeed/session.go
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package eventfeed
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/moby/moby/v2/daemon/seafield/sfcd"
+)
+
+// Purpose 32 EngineEvents: sfcd subscribes once per session; the engine
+// answers and then pushes kind 16 batches as records are stored.
+type (
+	SubscribeQ struct {
+		sfcd.Request
+		After uint64
+	}
+	SubscribeA struct {
+		sfcd.Reply
+		Boot string
+		Last uint64
+	}
+	// Range is a run of numbers that are gone.
+	Range struct{ From, To uint64 }
+	// Batch is one push. Records keep the upstream event encoding.
+	Batch struct {
+		Boot    string
+		Gap     *Range
+		Records []Record
+	}
+)
+
+const batchRecords = 200
+
+// batchBytes keeps one batch under the kind 16 budget.
+const batchBytes = sfcd.MaxAnswer - 8<<10
+
+// Serve answers purpose 32 from f.
+func Serve(f *Feed) sfcd.Handler {
+	return func(ctx context.Context, st *sfcd.Stream, req sfcd.Request, body []byte) error {
+		if req.Op != "subscribe" {
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.NotApplied, Reason: sfcd.Invalid})
+		}
+		var q SubscribeQ
+		if err := json.Unmarshal(body, &q); err != nil {
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.NotApplied, Reason: sfcd.Invalid})
+		}
+		if err := st.Answer(&SubscribeA{Reply: sfcd.Reply{OpID: req.OpID}, Boot: f.Boot(), Last: f.Last()}); err != nil {
+			return err
+		}
+		after := q.After
+		for {
+			recs, gap, changed, err := f.Read(after, batchRecords)
+			if err != nil {
+				st.Cancel()
+				return err
+			}
+			if len(recs) == 0 && gap == nil {
+				select {
+				case <-changed:
+					continue
+				case <-ctx.Done():
+					st.Cancel()
+					return ctx.Err()
+				}
+			}
+			b := Batch{Boot: f.Boot(), Records: []Record{}}
+			if gap != nil {
+				b.Gap = &Range{From: gap.From, To: gap.To}
+				after = max(after, gap.To)
+			}
+			size := 0
+			for _, r := range recs {
+				raw, _ := json.Marshal(r)
+				if len(b.Records) > 0 && size+len(raw) > batchBytes {
+					break
+				}
+				b.Records = append(b.Records, r)
+				size += len(raw) + 1
+				after = r.Seq
+			}
+			if err := st.Batch(b); err != nil {
+				return err
+			}
+		}
+	}
+}
