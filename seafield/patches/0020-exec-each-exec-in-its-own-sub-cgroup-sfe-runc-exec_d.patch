+//go:build linux
+
+package main
+
+import "testing"
+
+// The shim's exec command line: global flags, then exec with its own.
+func TestCommandFindsExec(t *testing.T) {
+	args := []string{"--root", "/run/sfe/runtime-runc/moby", "--log", "/x/log.json", "--log-format", "json", "--systemd-cgroup", "exec", "--process", "/tmp/p.json", "--detach", "--pid-file", "/b/abc123.pid", "ctr1"}
+	i := command(args)
+	if i != 7 || args[i] != "exec" {
+		t.Fatalf("command at %d", i)
+	}
+	if command([]string{"--debug", "--root=/r", "state", "x"}) != 2 {
+		t.Fatal("state not found")
+	}
+	if command([]string{"--version"}) != -1 {
+		t.Fatal("a flag-only call has no command")
+	}
+}
+
+func TestValidID(t *testing.T) {
+	for _, s := range []string{"", "../x", "a/b", "a.b"} {
+		if validID(s) {
+			t.Fatalf("%q accepted", s)
+		}
+	}
+	if !validID("0123abcdef") {
+		t.Fatal("hex id refused")
+	}
+}
