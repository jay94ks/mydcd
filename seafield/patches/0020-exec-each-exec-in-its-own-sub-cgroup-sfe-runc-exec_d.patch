diff --git a/daemon/seafield_exec.go b/daemon/seafield_exec.go
new file mode 100644
index 0000000..4ad7ee9
--- /dev/null
+++ b/daemon/seafield_exec.go
@@ -0,0 +1,22 @@
+package daemon
+
+import "github.com/moby/moby/v2/daemon/seafield/execsup"
+
+// SeafieldExec finds an exec for purpose 38 EngineExec (kill the whole
+// process tree). The daemon keeps exited execs until they are collected.
+func (daemon *Daemon) SeafieldExec(id string) (execsup.Exec, bool) {
+	ec := daemon.execCommands.Get(id)
+	if ec == nil {
+		return execsup.Exec{}, false
+	}
+	// The exit handler holds ec's lock for up to about 4 seconds while it
+	// waits on the tree and the streams; a kill waits that long at most.
+	ec.Lock()
+	dir, running := ec.SeafieldCgroup, ec.Running
+	ec.Unlock()
+	return execsup.Exec{
+		Dir:        dir,
+		Running:    running,
+		MarkKilled: func() { ec.SeafieldKilled.Store(true) },
+	}, true
+}
