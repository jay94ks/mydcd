diff --git a/daemon/seafield/execsup/execsup.go b/daemon/seafield/execsup/execsup.go
new file mode 100644
index 0000000..03cd2e2
--- /dev/null
+++ b/daemon/seafield/execsup/execsup.go
@@ -0,0 +1,186 @@
+// Package execsup supervises exec process trees. sfe-runc runs every exec
+// in a sub-cgroup of the container's cgroup (sfe-exec-<exec id>); the engine
+// waits on that cgroup for the whole tree to end and can kill the whole tree
+// with cgroup.kill. Purpose 38 EngineExec carries the kill.
+package execsup
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/containerd/log"
+	"github.com/moby/moby/v2/daemon/seafield/sfcd"
+)
+
+// Prefix names an exec's sub-cgroup (the same name sfe-runc creates).
+const Prefix = "sfe-exec-"
+
+// Runc is the file name of the wrapper, installed next to sfed.
+const Runc = "sfe-runc"
+
+// Tree states reported as the exec_die attribute seafield.tree.
+const (
+	Ended   = "ended"
+	Running = "running"
+)
+
+var warnOnce sync.Once
+
+// RuntimePath is the runtime binary for the stock runc runtime: sfe-runc
+// next to the running engine, else plain "runc" (execs then run
+// unsupervised, and the engine says so once).
+func RuntimePath() string {
+	if exe, err := os.Executable(); err == nil {
+		p := filepath.Join(filepath.Dir(exe), Runc)
+		if st, err := os.Stat(p); err == nil && st.Mode().IsRegular() && st.Mode()&0o111 != 0 {
+			return p
+		}
+	}
+	warnOnce.Do(func() {
+		log.G(context.TODO()).Warnf("Seafield: %s is not next to the engine; exec process trees are not supervised", Runc)
+	})
+	return "runc"
+}
+
+// Dir is the exec's sub-cgroup directory when sfe-runc created it, else "".
+// pid is the container's init process.
+func Dir(pid int, execID string) string {
+	if pid <= 0 || execID == "" || strings.ContainsAny(execID, "/.") {
+		return ""
+	}
+	cg, err := unified(pid)
+	if err != nil {
+		return ""
+	}
+	d := filepath.Join(cg, Prefix+execID)
+	if st, err := os.Stat(d); err != nil || !st.IsDir() {
+		return ""
+	}
+	return d
+}
+
+func unified(pid int) (string, error) {
+	f, err := os.Open(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	s := bufio.NewScanner(f)
+	for s.Scan() {
+		if p, ok := strings.CutPrefix(s.Text(), "0::"); ok {
+			return filepath.Join("/sys/fs/cgroup", filepath.Clean("/"+p)), nil
+		}
+	}
+	return "", errors.New("no cgroup v2 path")
+}
+
+// Populated reports whether any process is left in dir. A cgroup that is
+// gone has none.
+func Populated(dir string) bool {
+	b, err := os.ReadFile(filepath.Join(dir, "cgroup.events"))
+	if err != nil {
+		return false
+	}
+	for _, l := range strings.Split(string(b), "\n") {
+		if v, ok := strings.CutPrefix(l, "populated "); ok {
+			return strings.TrimSpace(v) != "0"
+		}
+	}
+	return false
+}
+
+// Wait waits up to d for dir to empty and reports Ended or Running. An
+// empty sub-cgroup is removed.
+func Wait(dir string, d time.Duration) string {
+	deadline := time.Now().Add(d)
+	for Populated(dir) {
+		if time.Now().After(deadline) {
+			return Running
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	_ = os.Remove(dir)
+	return Ended
+}
+
+// Kill kills every process left in dir (cgroup.kill) and waits for it to
+// empty. A sub-cgroup that is already gone has nothing to kill.
+func Kill(dir string) error {
+	if err := os.WriteFile(filepath.Join(dir, "cgroup.kill"), []byte("1"), 0); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if Wait(dir, 5*time.Second) != Ended {
+		return errors.New("exec processes still running after cgroup.kill")
+	}
+	return nil
+}
+
+// KillFailed is the reason of an unknown kill answer: cgroup.kill failed or
+// the tree did not end within 5 seconds.
+const KillFailed = "kill-failed"
+
+// Exec is what purpose 38 needs to know about an exec.
+type Exec struct {
+	// Dir is the exec's sub-cgroup, "" when the exec runs unsupervised.
+	Dir string
+	// Running is whether the exec's first process still runs.
+	Running bool
+	// MarkKilled records the kill for the exec_die attribute seafield.killed.
+	MarkKilled func()
+}
+
+// Lookup finds an exec by its id.
+type Lookup func(execID string) (Exec, bool)
+
+// KillQ is op "kill": kill the exec's whole process tree.
+type KillQ struct {
+	sfcd.Request
+	ExecID string
+}
+
+// KillA answers op "kill". Tree is "ended" once nothing of the exec runs.
+type KillA struct {
+	sfcd.Reply
+	Tree string `json:",omitempty"`
+}
+
+// Serve answers purpose 38. Answers: applied (the tree has ended, killed
+// now or before), not-found (no such exec), not-ready (the exec still runs
+// but has no sub-cgroup to kill it by), unknown kill-failed.
+func Serve(lookup Lookup) sfcd.Handler {
+	return func(ctx context.Context, st *sfcd.Stream, req sfcd.Request, body []byte) error {
+		var q KillQ
+		dec := json.NewDecoder(bytes.NewReader(body))
+		dec.DisallowUnknownFields()
+		if req.Op != "kill" || dec.Decode(&q) != nil || q.ExecID == "" {
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.NotApplied, Reason: sfcd.Invalid})
+		}
+		e, ok := lookup(q.ExecID)
+		if !ok {
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.NotApplied, Reason: sfcd.NotFound})
+		}
+		if e.Dir == "" {
+			if e.Running {
+				return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.NotApplied, Reason: sfcd.NotReady})
+			}
+			return st.Answer(&KillA{Reply: sfcd.Reply{OpID: req.OpID}, Tree: Ended})
+		}
+		if Populated(e.Dir) && e.MarkKilled != nil {
+			e.MarkKilled()
+		}
+		if err := Kill(e.Dir); err != nil {
+			log.G(ctx).WithError(err).WithField("exec", q.ExecID).Warn("Seafield: exec kill")
+			return st.Answer(&sfcd.Reply{OpID: req.OpID, Result: sfcd.Unknown, Reason: KillFailed})
+		}
+		return st.Answer(&KillA{Reply: sfcd.Reply{OpID: req.OpID}, Tree: Ended})
+	}
+}
