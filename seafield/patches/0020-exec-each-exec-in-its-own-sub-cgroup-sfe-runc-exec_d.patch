diff --git a/cmd/sfe-runc/main.go b/cmd/sfe-runc/main.go
new file mode 100644
index 0000000..55f779f
--- /dev/null
+++ b/cmd/sfe-runc/main.go
@@ -0,0 +1,157 @@
+//go:build linux
+
+// sfe-runc is the runtime binary the Seafield engine gives the runc shim.
+// It runs the real runc unchanged, except that every "runc exec" runs in a
+// sub-cgroup of its own (sfe-exec-<exec id>) under the container's cgroup,
+// so the engine can see when the exec's whole process tree has ended and
+// kill the whole tree (cgroup.kill), not only its first process.
+//
+// When anything about the sub-cgroup fails, the exec runs as upstream does
+// (in the container's cgroup) and the engine reports it as unsupervised.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+)
+
+// ExecCgroupPrefix names an exec's sub-cgroup; the engine uses the same name.
+const ExecCgroupPrefix = "sfe-exec-"
+
+// Global runc flags that take a value (the shim passes --root, --log,
+// --log-format; the others are here so the command is found anyway).
+var valueFlags = map[string]bool{"--root": true, "--log": true, "--log-format": true, "--criu": true, "--rootless": true}
+
+func main() {
+	real, err := realRunc()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "sfe-runc:", err)
+		os.Exit(127)
+	}
+	args := os.Args[1:]
+	if i := command(args); i >= 0 && args[i] == "exec" {
+		if sub, err := execCgroup(args[:i], args[i+1:]); err == nil {
+			args = append(append(append([]string{}, args[:i+1]...), "--cgroup", sub), args[i+1:]...)
+		} else {
+			fmt.Fprintln(os.Stderr, "sfe-runc: exec runs unsupervised:", err)
+		}
+	}
+	err = syscall.Exec(real, append([]string{"runc"}, args...), os.Environ())
+	fmt.Fprintln(os.Stderr, "sfe-runc:", err)
+	os.Exit(127)
+}
+
+// realRunc is $SFE_RUNC, else the first runc on PATH.
+func realRunc() (string, error) {
+	if p := os.Getenv("SFE_RUNC"); p != "" {
+		return p, nil
+	}
+	return exec.LookPath("runc")
+}
+
+// command is the index of the runc subcommand in args, or -1.
+func command(args []string) int {
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		if !strings.HasPrefix(a, "-") {
+			return i
+		}
+		if valueFlags[a] {
+			i++
+		}
+	}
+	return -1
+}
+
+// execCgroup creates the exec's sub-cgroup and returns its name relative to
+// the container's cgroup. The exec id is the --pid-file name the shim
+// passes (<bundle>/<exec id>.pid); the container id is the last argument.
+func execCgroup(global, rest []string) (string, error) {
+	if len(rest) == 0 {
+		return "", fmt.Errorf("no container id")
+	}
+	id := rest[len(rest)-1]
+	pidFile := ""
+	for i, a := range rest {
+		if a == "--pid-file" && i+1 < len(rest) {
+			pidFile = rest[i+1]
+		} else if v, ok := strings.CutPrefix(a, "--pid-file="); ok {
+			pidFile = v
+		}
+	}
+	execID := strings.TrimSuffix(filepath.Base(pidFile), ".pid")
+	if !validID(execID) || !validID(id) {
+		return "", fmt.Errorf("no exec id in --pid-file %q", pidFile)
+	}
+	pid, err := initPid(global, id)
+	if err != nil {
+		return "", err
+	}
+	cg, err := Unified(pid)
+	if err != nil {
+		return "", err
+	}
+	sub := ExecCgroupPrefix + execID
+	if err := os.Mkdir(filepath.Join(cg, sub), 0o755); err != nil && !os.IsExist(err) {
+		return "", err
+	}
+	return sub, nil
+}
+
+func validID(s string) bool {
+	if s == "" || len(s) > 128 {
+		return false
+	}
+	for _, r := range s {
+		if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+// initPid reads the container's init process from runc's own state file
+// (<root>/<id>/state.json), without starting another process.
+func initPid(global []string, id string) (int, error) {
+	root := "/run/runc"
+	for i := 0; i < len(global); i++ {
+		if global[i] == "--root" && i+1 < len(global) {
+			root = global[i+1]
+		} else if v, ok := strings.CutPrefix(global[i], "--root="); ok {
+			root = v
+		}
+	}
+	b, err := os.ReadFile(filepath.Join(root, id, "state.json"))
+	if err != nil {
+		return 0, err
+	}
+	var st struct {
+		Pid int `json:"init_process_pid"`
+	}
+	if err := json.Unmarshal(b, &st); err != nil || st.Pid <= 0 {
+		return 0, fmt.Errorf("runc state.json: no init pid")
+	}
+	return st.Pid, nil
+}
+
+// Unified is the cgroup v2 directory of pid under /sys/fs/cgroup.
+func Unified(pid int) (string, error) {
+	f, err := os.Open(fmt.Sprintf("/proc/%d/cgroup", pid))
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	s := bufio.NewScanner(f)
+	for s.Scan() {
+		if p, ok := strings.CutPrefix(s.Text(), "0::"); ok {
+			return filepath.Join("/sys/fs/cgroup", filepath.Clean("/"+p)), nil
+		}
+	}
+	return "", fmt.Errorf("pid %d: no cgroup v2 path", pid)
+}
