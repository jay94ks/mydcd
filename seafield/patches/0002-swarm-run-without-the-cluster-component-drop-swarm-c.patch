diff --git a/daemon/command/seafield_noswarm.go b/daemon/command/seafield_noswarm.go
new file mode 100644
index 0000000..ae12f48
--- /dev/null
+++ b/daemon/command/seafield_noswarm.go
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package command
+
+import (
+	"context"
+
+	"github.com/moby/moby/api/types/network"
+	"github.com/moby/moby/api/types/swarm"
+	"github.com/moby/moby/api/types/volume"
+	"github.com/moby/moby/v2/daemon/libnetwork/cluster"
+	dnetwork "github.com/moby/moby/v2/daemon/network"
+	"github.com/moby/moby/v2/daemon/server/volumebackend"
+	"github.com/moby/moby/v2/errdefs"
+)
+
+// noSwarm stands in for the Swarm cluster component, which Seafield does not
+// have: sfcd manages the cluster. Every swarm-scoped lookup finds nothing and
+// every swarm-scoped change is refused, so the local network, volume and
+// system routes behave exactly as on a node that never joined a swarm.
+type noSwarm struct{}
+
+var errNoSwarm = errdefs.NotImplemented(swarmDisabled{})
+
+type swarmDisabled struct{}
+
+func (swarmDisabled) Error() string { return "swarm mode is not available in Seafield" }
+
+func (noSwarm) IsAgent() bool   { return false }
+func (noSwarm) IsManager() bool { return false }
+
+func (noSwarm) SendClusterEvent(cluster.ConfigEventType) {}
+
+func (noSwarm) Info(context.Context) swarm.Info {
+	return swarm.Info{LocalNodeState: swarm.LocalNodeStateInactive}
+}
+
+func (noSwarm) GetNetwork(name string, _ bool) (network.Inspect, error) {
+	return network.Inspect{}, errdefs.NotFound(swarmDisabled{})
+}
+
+func (noSwarm) GetNetworks(dnetwork.Filter, bool) ([]network.Inspect, error) { return nil, nil }
+
+func (noSwarm) GetNetworkSummaries(dnetwork.Filter) ([]network.Summary, error) { return nil, nil }
+
+func (noSwarm) GetNetworksByName(string) ([]network.Network, error) { return nil, nil }
+
+func (noSwarm) CreateNetwork(network.CreateRequest) (string, error) { return "", errNoSwarm }
+
+func (noSwarm) RemoveNetwork(string) error { return errdefs.NotFound(swarmDisabled{}) }
+
+func (noSwarm) GetVolume(string) (volume.Volume, error) {
+	return volume.Volume{}, errdefs.NotFound(swarmDisabled{})
+}
+
+func (noSwarm) GetVolumes(volumebackend.ListOptions) ([]volume.Volume, error) { return nil, nil }
+
+func (noSwarm) CreateVolume(volume.CreateRequest) (*volume.Volume, error) { return nil, errNoSwarm }
+
+func (noSwarm) RemoveVolume(string, bool) error { return errNoSwarm }
+
+func (noSwarm) UpdateVolume(string, uint64, volumebackend.UpdateOptions) error { return errNoSwarm }
