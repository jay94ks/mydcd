diff --git a/daemon/volume/mounts/seafield_container.go b/daemon/volume/mounts/seafield_container.go
new file mode 100644
index 0000000..76df622
--- /dev/null
+++ b/daemon/volume/mounts/seafield_container.go
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package mounts
+
+import (
+	"context"
+
+	"github.com/moby/moby/v2/daemon/volume"
+)
+
+type containerKey struct{}
+
+// WithContainer records which container a mount is being set up for. The
+// built-in sfc volume driver needs it: sfcd answers a mount only for a
+// container it created.
+func WithContainer(ctx context.Context, id string) context.Context {
+	return context.WithValue(ctx, containerKey{}, id)
+}
+
+// ContainerFrom returns the id set by WithContainer, or "".
+func ContainerFrom(ctx context.Context) string {
+	id, _ := ctx.Value(containerKey{}).(string)
+	return id
+}
+
+// ContainerMounter is a volume that mounts per container (driver "sfc").
+type ContainerMounter interface {
+	MountFor(ctx context.Context, id string) (string, error)
+}
+
+// MountVolume mounts v for ref, passing ctx (and its container) to a
+// ContainerMounter found through any Unwrap chain.
+func MountVolume(ctx context.Context, v volume.Volume, id string) (string, error) {
+	for {
+		if cm, ok := v.(ContainerMounter); ok {
+			return cm.MountFor(ctx, id)
+		}
+		u, ok := v.(interface{ Unwrap() volume.Volume })
+		if !ok {
+			return v.Mount(id)
+		}
+		v = u.Unwrap()
+	}
+}
