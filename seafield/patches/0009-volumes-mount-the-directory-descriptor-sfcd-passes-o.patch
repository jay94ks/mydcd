 }
 
diff --git a/daemon/seafield/volumedrv/mount_linux.go b/daemon/seafield/volumedrv/mount_linux.go
new file mode 100644
index 0000000..d4a05ba
--- /dev/null
+++ b/daemon/seafield/volumedrv/mount_linux.go
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package volumedrv
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+
+	"golang.org/x/sys/unix"
+)
+
+// Root is where volume mounts are attached, under the engine exec-root
+// (set at start: <exec-root>/volumes). runc bind-mounts from here.
+var Root = "/run/sfe/volumes"
+
+type mountAnswer struct {
+	ReadOnly bool   `json:"read_only"`
+	Dev      uint64 `json:"dev"`
+	Ino      uint64 `json:"ino"`
+}
+
+var validID = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$`)
+
+func mountPath(id string) (string, error) {
+	if !validID.MatchString(id) {
+		return "", fmt.Errorf("invalid mount id %q", id)
+	}
+	return filepath.Join(Root, id), nil
+}
+
+// attach clones the mount tree of the directory fd sfcd passed
+// (open_tree OPEN_TREE_CLONE), applies read-only when asked, and moves it
+// onto target. A target already holding the same directory (the same
+// mount_id again) is left as it is.
+func attach(fd int, target string, a mountAnswer) error {
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return errors.New("sfcd passed a descriptor that is not a directory")
+	}
+	if (a.Dev != 0 || a.Ino != 0) && (uint64(st.Dev) != a.Dev || st.Ino != a.Ino) {
+		return fmt.Errorf("sfcd descriptor is %d:%d, answer says %d:%d", st.Dev, st.Ino, a.Dev, a.Ino)
+	}
+	if err := os.MkdirAll(Root, 0o700); err != nil {
+		return err
+	}
+	if err := os.Mkdir(target, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+		return err
+	}
+	var cur unix.Stat_t
+	if err := unix.Lstat(target, &cur); err == nil && cur.Dev == st.Dev && cur.Ino == st.Ino {
+		return nil
+	}
+	tree, err := unix.OpenTree(fd, "", unix.OPEN_TREE_CLONE|unix.OPEN_TREE_CLOEXEC|unix.AT_EMPTY_PATH)
+	if err != nil {
+		return fmt.Errorf("open_tree: %w", err)
+	}
+	defer unix.Close(tree)
+	if a.ReadOnly {
+		attr := unix.MountAttr{Attr_set: unix.MOUNT_ATTR_RDONLY}
+		if err = unix.MountSetattr(tree, "", unix.AT_EMPTY_PATH|unix.AT_RECURSIVE, &attr); err != nil {
+			return fmt.Errorf("mount_setattr rdonly: %w", err)
+		}
+	}
+	if err = unix.MoveMount(tree, "", unix.AT_FDCWD, target, unix.MOVE_MOUNT_F_EMPTY_PATH); err != nil {
+		return fmt.Errorf("move_mount: %w", err)
+	}
+	return nil
+}
+
+// detach removes the mount at target (if any) and the empty directory.
+func detach(target string) error {
+	for {
+		err := unix.Unmount(target, unix.MNT_DETACH|unix.UMOUNT_NOFOLLOW)
+		if err != nil {
+			if errors.Is(err, unix.EINVAL) || errors.Is(err, unix.ENOENT) {
+				break
+			}
+			return err
+		}
+	}
+	if err := os.Remove(target); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	return nil
+}
