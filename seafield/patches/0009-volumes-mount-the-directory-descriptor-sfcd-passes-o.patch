diff --git a/daemon/seafield/sfcd/fd_linux.go b/daemon/seafield/sfcd/fd_linux.go
new file mode 100644
index 0000000..64b150b
--- /dev/null
+++ b/daemon/seafield/sfcd/fd_linux.go
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package sfcd
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+
+	"golang.org/x/sys/unix"
+)
+
+// DoFD is Do for an answer that carries one descriptor (SCM_RIGHTS on the
+// first bytes of the response): the volume Mount answer. It uses its own
+// connection, which sfcd closes after the answer. The caller owns the
+// returned fd; it is -1 when err is not nil.
+func (c *Client) DoFD(ctx context.Context, method, path string, body, out any) (int, error) {
+	b, err := json.Marshal(body)
+	if err != nil {
+		return -1, err
+	}
+	req, err := http.NewRequestWithContext(ctx, method, "http://sfcd/v1"+path, bytes.NewReader(b))
+	if err != nil {
+		return -1, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	conn, err := c.dial(ctx, "unix", "")
+	if err != nil {
+		return -1, err
+	}
+	defer conn.Close()
+	if dl, ok := ctx.Deadline(); ok {
+		_ = conn.SetDeadline(dl)
+	}
+	uc := conn.(*net.UnixConn)
+	if err = req.Write(uc); err != nil {
+		return -1, err
+	}
+	buf, oob := make([]byte, 64<<10), make([]byte, unix.CmsgSpace(4*4))
+	n, oobn, _, _, err := uc.ReadMsgUnix(buf, oob)
+	if err != nil {
+		return -1, err
+	}
+	fd := -1
+	if oobn > 0 {
+		msgs, err := unix.ParseSocketControlMessage(oob[:oobn])
+		if err != nil {
+			return -1, err
+		}
+		for i := range msgs {
+			fds, err := unix.ParseUnixRights(&msgs[i])
+			if err != nil {
+				continue
+			}
+			for _, f := range fds {
+				if fd < 0 {
+					fd = f
+				} else {
+					_ = unix.Close(f)
+				}
+			}
+		}
+	}
+	ok := false
+	defer func() {
+		if !ok && fd >= 0 {
+			_ = unix.Close(fd)
+		}
+	}()
+	resp, err := http.ReadResponse(bufio.NewReader(io.MultiReader(bytes.NewReader(buf[:n]), uc)), req)
+	if err != nil {
+		return -1, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode/100 != 2 {
+		e := &Error{Status: resp.StatusCode}
+		_ = json.NewDecoder(io.LimitReader(resp.Body, 64<<10)).Decode(e)
+		return -1, e
+	}
+	if fd < 0 {
+		return -1, errors.New("sfcd answer carried no descriptor")
+	}
+	if out != nil {
+		if err = json.NewDecoder(io.LimitReader(resp.Body, 64<<10)).Decode(out); err != nil {
+			return -1, err
+		}
+	}
+	ok = true
+	return fd, nil
+}
