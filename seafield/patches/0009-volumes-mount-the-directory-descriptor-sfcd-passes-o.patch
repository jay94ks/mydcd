+	fd, err := v.d.c.DoFD(ctx, http.MethodPost, "/volumes/"+url.PathEscape(v.info.Name)+"/mount", map[string]string{"mount_id": id, "container_id": cid}, &out)
+	if err != nil {
+		return "", mapErr(err)
+	}
+	defer unix.Close(fd)
+	if err = attach(fd, target, out); err != nil {
