diff --git a/daemon/seafield/eventfeed/feed.go b/daemon/seafield/eventfeed/feed.go
new file mode 100644
index 0000000..bb19fb3
--- /dev/null
+++ b/daemon/seafield/eventfeed/feed.go
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// Package eventfeed keeps every engine event in a numbered, durable feed.
+//
+// The upstream events service holds only the last 256 events in memory and
+// drops them for a subscriber that falls behind, so a client that was away
+// cannot tell what it missed. The feed numbers each event (Seq, starting at
+// 1 and never reused), stores it on disk, and lets a reader continue from
+// the last number it saw. When a reader asks for numbers that were already
+// trimmed, it is told exactly which range is gone.
+package eventfeed
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	eventtypes "github.com/moby/moby/api/types/events"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Record is one numbered event.
+type Record struct {
+	Seq   uint64             `json:"seq"`
+	Boot  string             `json:"boot"`
+	Event eventtypes.Message `json:"event"`
+}
+
+// Limits on what the feed keeps on disk. The oldest records go first.
+const (
+	keepRecords   = 200_000
+	flushInterval = 50 * time.Millisecond
+	maxPending    = 65_536
+)
+
+var bucket = []byte("events")
+
+// Feed is the durable event feed of one engine.
+type Feed struct {
+	db   *bolt.DB
+	boot string
+
+	mu      sync.Mutex
+	next    uint64 // seq the next record gets
+	oldest  uint64 // oldest seq still on disk or pending (0: none yet)
+	pending []Record
+	lost    uint64 // records dropped because the writer fell maxPending behind
+	wake    chan struct{}
+	notify  chan struct{} // closed and replaced whenever records are stored
+	closed  bool
+	done    chan struct{}
+}
+
+// Open opens (or creates) the feed under root and starts its writer.
+func Open(root string) (*Feed, error) {
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		return nil, err
+	}
+	db, err := bolt.Open(filepath.Join(root, "events.db"), 0o600, &bolt.Options{Timeout: time.Second})
+	if err != nil {
+		return nil, err
+	}
+	var b [8]byte
+	_, _ = rand.Read(b[:])
+	f := &Feed{db: db, boot: hex.EncodeToString(b[:]), next: 1, wake: make(chan struct{}, 1), notify: make(chan struct{}), done: make(chan struct{})}
+	err = db.Update(func(tx *bolt.Tx) error {
+		bk, err := tx.CreateBucketIfNotExists(bucket)
+		if err != nil {
+			return err
+		}
+		c := bk.Cursor()
+		if k, _ := c.Last(); k != nil {
+			f.next = binary.BigEndian.Uint64(k) + 1
+		}
+		if k, _ := c.First(); k != nil {
+			f.oldest = binary.BigEndian.Uint64(k)
+		}
+		return nil
+	})
+	if err != nil {
+		_ = db.Close()
+		return nil, err
+	}
+	go f.writer()
+	return f, nil
+}
+
+// Boot names this engine run. A reader that sees it change knows the
+// engine restarted and should re-read current state once.
+func (f *Feed) Boot() string { return f.boot }
+
+// Add numbers ev and queues it for storage. It never blocks on disk.
+func (f *Feed) Add(ev eventtypes.Message) {
+	f.mu.Lock()
+	if f.closed {
+		f.mu.Unlock()
+		return
+	}
+	if len(f.pending) >= maxPending {
+		// The disk cannot keep up: drop this record but keep its number,
+		// so readers see a gap instead of silently missing it.
+		f.lost++
+		f.next++
+		f.mu.Unlock()
+		return
+	}
+	r := Record{Seq: f.next, Boot: f.boot, Event: ev}
+	f.next++
+	if f.oldest == 0 {
+		f.oldest = r.Seq
+	}
+	f.pending = append(f.pending, r)
+	f.mu.Unlock()
+	select {
+	case f.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (f *Feed) writer() {
+	defer close(f.done)
+	t := time.NewTimer(flushInterval)
+	defer t.Stop()
+	for {
+		f.mu.Lock()
+		batch := f.pending
+		f.pending = nil
+		closed := f.closed
+		f.mu.Unlock()
+		if len(batch) > 0 {
+			f.store(batch)
+		}
+		if closed {
+			return
+		}
+		select {
+		case <-f.wake:
+		case <-t.C:
+		}
+		t.Reset(flushInterval)
+	}
+}
+
+func (f *Feed) store(batch []Record) {
+	err := f.db.Update(func(tx *bolt.Tx) error {
+		bk := tx.Bucket(bucket)
+		for _, r := range batch {
+			v, err := json.Marshal(r)
+			if err != nil {
+				return err
+			}
+			if err = bk.Put(key(r.Seq), v); err != nil {
+				return err
+			}
+		}
+		// Trim the oldest records beyond keepRecords.
+		if n := bk.Stats().KeyN; n > keepRecords {
+			c := bk.Cursor()
+			for k, _ := c.First(); k != nil && n > keepRecords; k, _ = c.Next() {
+				if err := c.Delete(); err != nil {
+					return err
+				}
+				n--
+			}
+		}
+		return nil
+	})
+	f.mu.Lock()
+	if err == nil {
+		_ = f.db.View(func(tx *bolt.Tx) error {
+			if k, _ := tx.Bucket(bucket).Cursor().First(); k != nil {
+				f.oldest = binary.BigEndian.Uint64(k)
+			}
+			return nil
+		})
+	}
+	close(f.notify)
+	f.notify = make(chan struct{})
+	f.mu.Unlock()
+}
+
+// Gap reports a range of numbers a reader asked for but can no longer get.
+type Gap struct {
+	From uint64 `json:"from"`
+	To   uint64 `json:"to"`
+}
+
+// Read returns stored records with Seq > after, at most limit of them, and
+// a Gap when some numbers right after `after` are gone. changed is closed
+// when more records are stored, for a reader that wants to wait.
+func (f *Feed) Read(after uint64, limit int) (recs []Record, gap *Gap, changed <-chan struct{}, err error) {
+	f.mu.Lock()
+	changed = f.notify
+	oldest := f.oldest
+	f.mu.Unlock()
+	if oldest > after+1 {
+		gap = &Gap{From: after + 1, To: oldest - 1}
+	}
+	err = f.db.View(func(tx *bolt.Tx) error {
+		c := tx.Bucket(bucket).Cursor()
+		expect := after + 1
+		if gap != nil {
+			expect = oldest
+		}
+		for k, v := c.Seek(key(after + 1)); k != nil && len(recs) < limit; k, v = c.Next() {
+			var r Record
+			if err := json.Unmarshal(v, &r); err != nil {
+				return err
+			}
+			if r.Seq != expect && gap == nil && len(recs) == 0 {
+				// numbers dropped by Add (lost) right after `after`
+				gap = &Gap{From: expect, To: r.Seq - 1}
+			} else if r.Seq != expect {
+				// a hole in the middle: stop here so the next Read reports it
+				break
+			}
+			recs = append(recs, r)
+			expect = r.Seq + 1
+		}
+		return nil
+	})
+	return recs, gap, changed, err
+}
+
+// Close stops the writer after it stored what was queued.
+func (f *Feed) Close() error {
+	f.mu.Lock()
+	if f.closed {
+		f.mu.Unlock()
+		return errors.New("eventfeed: already closed")
+	}
+	f.closed = true
+	f.mu.Unlock()
+	select {
+	case f.wake <- struct{}{}:
+	default:
+	}
+	<-f.done
+	return f.db.Close()
+}
+
+func key(seq uint64) []byte {
+	var b [8]byte
+	binary.BigEndian.PutUint64(b[:], seq)
+	return b[:]
+}
diff --git a/daemon/seafield/eventfeed/feed_test.go b/daemon/seafield/eventfeed/feed_test.go
new file mode 100644
index 0000000..2a4e65d
--- /dev/null
+++ b/daemon/seafield/eventfeed/feed_test.go
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package eventfeed
+
+import (
+	"testing"
+	"time"
+
+	eventtypes "github.com/moby/moby/api/types/events"
+)
+
+func waitStored(t *testing.T, f *Feed, n int) []Record {
+	t.Helper()
+	for i := 0; i < 200; i++ {
+		recs, _, _, err := f.Read(0, 1000)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(recs) >= n {
+			return recs
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("records not stored")
+	return nil
+}
+
+func TestNumbersSurviveReopen(t *testing.T) {
+	dir := t.TempDir()
+	f, err := Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ {
+		f.Add(eventtypes.Message{Action: "start"})
+	}
+	recs := waitStored(t, f, 3)
+	if recs[0].Seq != 1 || recs[2].Seq != 3 {
+		t.Fatalf("seq %d..%d", recs[0].Seq, recs[2].Seq)
+	}
+	boot := f.Boot()
+	if err = f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	f, err = Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if f.Boot() == boot {
+		t.Fatal("boot did not change")
+	}
+	f.Add(eventtypes.Message{Action: "die"})
+	recs = waitStored(t, f, 4)
+	if recs[3].Seq != 4 || recs[3].Boot != f.Boot() {
+		t.Fatalf("after reopen: %+v", recs[3])
+	}
+	got, gap, _, err := f.Read(2, 10)
+	if err != nil || gap != nil || len(got) != 2 || got[0].Seq != 3 {
+		t.Fatalf("read after 2: %v %v %v", got, gap, err)
+	}
+}
+
+func TestTrimmedRangeIsReported(t *testing.T) {
+	f, err := Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	f.mu.Lock()
+	f.next, f.oldest = 10, 10 // pretend 1..9 were trimmed
+	f.mu.Unlock()
+	f.Add(eventtypes.Message{Action: "start"})
+	waitStored(t, f, 1)
+	recs, gap, _, err := f.Read(3, 10)
+	if err != nil || gap == nil || gap.From != 4 || gap.To != 9 || len(recs) != 1 || recs[0].Seq != 10 {
+		t.Fatalf("gap %+v recs %+v err %v", gap, recs, err)
+	}
+}
+
+func TestDroppedNumbersAreReported(t *testing.T) {
+	f, err := Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	f.Add(eventtypes.Message{Action: "a"}) // 1
+	waitStored(t, f, 1)
+	f.mu.Lock()
+	f.next += 2 // 2 and 3 dropped by an overflowing writer
+	f.mu.Unlock()
+	f.Add(eventtypes.Message{Action: "b"}) // 4
+	var (
+		recs []Record
+		gap  *Gap
+	)
+	for i := 0; i < 200 && len(recs) == 0; i++ {
+		time.Sleep(10 * time.Millisecond)
+		recs, gap, _, err = f.Read(1, 10)
+	}
+	if err != nil || gap == nil || gap.From != 2 || gap.To != 3 || len(recs) != 1 || recs[0].Seq != 4 {
+		t.Fatalf("gap %+v recs %+v err %v", gap, recs, err)
+	}
+	// a reader that already has 1 must not be handed 4 as if contiguous
+	recs, gap, _, _ = f.Read(0, 10)
+	if gap != nil || len(recs) != 1 || recs[0].Seq != 1 {
+		t.Fatalf("from 0: gap %+v recs %+v", gap, recs)
+	}
+}
