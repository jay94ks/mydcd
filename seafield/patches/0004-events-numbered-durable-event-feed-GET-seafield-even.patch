@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package eventfeed
+
+import (
+	"github.com/moby/moby/v2/daemon/events"
+)
+
+// Attach makes every event the engine publishes also go into f, in the
+// order the events service receives them, before any subscriber sees them.
+func Attach(f *Feed) { events.Recorder = f.Add }
diff --git a/daemon/seafield/eventfeed/router.go b/daemon/seafield/eventfeed/router.go
new file mode 100644
index 0000000..f766e3b
--- /dev/null
+++ b/daemon/seafield/eventfeed/router.go
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package eventfeed
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/moby/moby/v2/daemon/server/httputils"
+	"github.com/moby/moby/v2/daemon/server/router"
+	"github.com/moby/moby/v2/errdefs"
+)
+
+// Page is the answer to GET /seafield/events.
+type Page struct {
+	Boot    string   `json:"boot"`
+	Gap     *Gap     `json:"gap,omitempty"`
+	Records []Record `json:"records"`
+}
+
+const (
+	defaultLimit = 1000
+	maxLimit     = 10_000
+	maxWait      = 60 * time.Second
+)
+
+type feedRouter struct{ f *Feed }
+
+// NewRouter serves the feed:
+//
+//	GET /seafield/events?after=N[&limit=M][&wait=SECONDS]
+//
+// returns records numbered after N (oldest first). With wait, an empty
+// answer is held until a record arrives or the wait ends (at most 60s).
+func NewRouter(f *Feed) router.Router { return feedRouter{f: f} }
+
+func (r feedRouter) Routes() []router.Route {
+	return []router.Route{router.NewGetRoute("/seafield/events", r.get)}
+}
+
+func (r feedRouter) get(ctx context.Context, w http.ResponseWriter, req *http.Request, _ map[string]string) error {
+	q := req.URL.Query()
+	after, err := strconv.ParseUint(q.Get("after"), 10, 64)
+	if q.Get("after") != "" && err != nil {
+		return errdefs.InvalidParameter(err)
+	}
+	limit := defaultLimit
+	if v := q.Get("limit"); v != "" {
+		if limit, err = strconv.Atoi(v); err != nil || limit <= 0 {
+			return errdefs.InvalidParameter(errBadLimit{})
+		}
+		limit = min(limit, maxLimit)
+	}
+	var wait time.Duration
+	if v := q.Get("wait"); v != "" {
+		s, err := strconv.Atoi(v)
+		if err != nil || s < 0 {
+			return errdefs.InvalidParameter(errBadWait{})
+		}
+		wait = min(time.Duration(s)*time.Second, maxWait)
+	}
+	deadline := time.NewTimer(wait)
+	defer deadline.Stop()
+	for {
+		recs, gap, changed, err := r.f.Read(after, limit)
+		if err != nil {
+			return err
+		}
+		if len(recs) > 0 || gap != nil || wait == 0 {
+			if recs == nil {
+				recs = []Record{}
+			}
+			return httputils.WriteJSON(w, http.StatusOK, Page{Boot: r.f.Boot(), Gap: gap, Records: recs})
+		}
+		select {
+		case <-changed:
+		case <-deadline.C:
+			wait = 0
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+}
+
+type errBadLimit struct{}
+
+func (errBadLimit) Error() string { return "limit must be a positive number" }
+
+type errBadWait struct{}
+
+func (errBadWait) Error() string { return "wait must be a number of seconds" }
