+// SPDX-License-Identifier: Apache-2.0
+
+package driverapi
+
+import "context"
+
+type containerKey struct{}
+
+// WithContainer records the container a Join is for (Seafield driver "sfc").
+func WithContainer(ctx context.Context, id string) context.Context {
+	return context.WithValue(ctx, containerKey{}, id)
+}
+
+// ContainerFrom returns the id set by WithContainer, or "".
+func ContainerFrom(ctx context.Context) string {
+	id, _ := ctx.Value(containerKey{}).(string)
+	return id
+}
