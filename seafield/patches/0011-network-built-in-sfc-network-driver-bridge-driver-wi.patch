+// SPDX-License-Identifier: Apache-2.0
+
+package bridge
+
+import (
+	"errors"
+
+	"github.com/moby/moby/v2/daemon/libnetwork/driverapi"
+)
+
+// Wrappers register more network types served by this same bridge driver
+// instance (Seafield: driver "sfc" calls sfcd around each step). One
+// instance keeps one store and one set of networks for both types.
+var Wrappers []func(driverapi.Driver) (string, driverapi.Driver)
+
+// HostVeth returns the host side veth of endpoint eid.
+func HostVeth(drv driverapi.Driver, nid, eid string) (string, error) {
+	d, ok := drv.(*driver)
+	if !ok {
+		return "", errors.New("not the bridge driver")
+	}
+	n, err := d.getNetwork(nid)
+	if err != nil {
+		return "", err
+	}
+	ep, err := n.getEndpoint(eid)
+	if err != nil || ep == nil {
+		return "", errors.Join(err, errors.New("endpoint not found"))
+	}
+	return ep.hostName, nil
+}
