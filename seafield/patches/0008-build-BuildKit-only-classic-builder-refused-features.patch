diff --git a/daemon/command/seafield_build.go b/daemon/command/seafield_build.go
new file mode 100644
index 0000000..720358d
--- /dev/null
+++ b/daemon/command/seafield_build.go
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package command
+
+import (
+	"context"
+	"errors"
+
+	"github.com/moby/moby/v2/daemon/builder"
+	"github.com/moby/moby/v2/daemon/server/buildbackend"
+	"github.com/moby/moby/v2/daemon/server/router/system"
+)
+
+// errClassicBuild answers a build request without "version=2". Seafield
+// builds only through the built-in BuildKit; the classic Dockerfile builder
+// is not started (its package stays linked for commit/import --change).
+var errClassicBuild = errors.New("seafield builds only with BuildKit (version=2); the classic builder is removed")
+
+type classicRefused struct{}
+
+func (classicRefused) Build(context.Context, buildbackend.BuildConfig) (*builder.Result, error) {
+	return nil, errClassicBuild
+}
+
+// buildEnabled reports whether this node builds images. daemon.json
+// "features": {"buildkit": false} turns building off for the node (sfc
+// node.yaml engine build switch): BuildKit is not started and the build,
+// session and gRPC routes are not served.
+func buildEnabled(features map[string]bool) bool {
+	enabled, ok := features["buildkit"]
+	return !ok || enabled
+}
+
+// systemBuilder avoids handing the system router a typed nil when building
+// is off, so disk usage simply omits the build cache.
+func systemBuilder(b builderOptions) system.BuildBackend {
+	if b.buildkit == nil {
+		return nil
+	}
+	return b.buildkit
+}
