+	"testing"
+
+	"github.com/containerd/containerd/v2/core/images"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/moby/moby/v2/daemon/seafield/sfcd"
+	"github.com/moby/moby/v2/daemon/seafield/sfcp/wire"
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+type fakeSfcd struct {
+	content map[string][]byte // repo@digest
+	asked   []ContentQ
+}
+
+func (f *fakeSfcd) CallStream(_ context.Context, p wire.Purpose, op string, req sfcd.Requester, out sfcd.Replier) (io.ReadCloser, error) {
+	q := *req.(*ContentQ)
+	q.Op = op
+	f.asked = append(f.asked, q)
+	b, ok := f.content[q.Repository+"@"+q.Digest]
+	if p != sfcd.Image || !ok {
+		return nil, &sfcd.Error{Result: sfcd.NotApplied, Code: sfcd.NotFound, Sent: true}
+	}
+	a := out.(*ContentA)
+	a.ContentType, a.Size = "application/vnd.oci.image.manifest.v1+json", int64(len(b))
+	return io.NopCloser(bytes.NewReader(b[q.Offset:])), nil
+}
+
+func TestRepositoryKeepsTheWrittenName(t *testing.T) {
+	d := digest.FromString("x")
+	for in, want := range map[string]string{
+		"sfc-cluster-app/web@" + d.String():           "sfc-cluster-app/web",
+		"docker.io/sfc-cluster-app/web@" + d.String(): "sfc-cluster-app/web",
+		"reg.example:5000/t/a@" + d.String():          "reg.example:5000/t/a",
+		"alpine@" + d.String():                        "alpine",
+	} {
+		got, dg, err := Repository(in)
+		if err != nil || got != want || dg != d {
+			t.Fatal(in, got, err)
+		}
+	}
+	if _, _, err := Repository("sfc-cluster-app/web:latest"); !cerrdefs.IsInvalidArgument(err) {
+		t.Fatal("tag accepted", err)
+	}
+}
