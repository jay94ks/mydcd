+func TestResolveAndFetch(t *testing.T) {
+	manifest := []byte(`{"schemaVersion":2}`)
+	blob := []byte("layer bytes 0123456789")
+	md, bd := digest.FromBytes(manifest), digest.FromBytes(blob)
