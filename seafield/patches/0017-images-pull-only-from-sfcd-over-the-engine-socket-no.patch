diff --git a/daemon/seafield/imagesrc/resolver.go b/daemon/seafield/imagesrc/resolver.go
new file mode 100644
index 0000000..926a5cc
--- /dev/null
+++ b/daemon/seafield/imagesrc/resolver.go
@@ -0,0 +1,199 @@
+// Package imagesrc is the engine's only image source: every manifest and
+// blob comes from sfcd over the engine socket (purpose 37), never from a
+// registry. A reference must carry its digest; tags are resolved by sfcd
+// before it asks the engine to pull.
+package imagesrc
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+
+	"github.com/containerd/containerd/v2/core/images"
+	"github.com/containerd/containerd/v2/core/remotes"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/distribution/reference"
+	"github.com/moby/moby/v2/daemon/seafield/sfcd"
+	"github.com/moby/moby/v2/daemon/seafield/sfcp/wire"
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// Purpose 37 bodies (seafield/docs/sfcd-socket.md "op 구조체").
+type (
+	ContentQ struct {
+		sfcd.Request
+		Repository string
+		Digest     string
+		Offset     uint64
+	}
+	ContentA struct {
+		sfcd.Reply
+		ContentType string
+		Size        int64
+	}
+)
+
+// ErrNoRegistry is returned wherever upstream would contact a registry.
+var ErrNoRegistry = cerrdefs.ErrNotImplemented.WithMessage("seafield: the engine does not use registries; images come from sfcd")
+
+// Caller is the part of the sfcd client the source uses.
+type Caller interface {
+	CallStream(ctx context.Context, p wire.Purpose, op string, req sfcd.Requester, out sfcd.Replier) (io.ReadCloser, error)
+}
+
+// Resolver is a containerd remotes.Resolver over sfcd.
+type Resolver struct{ C Caller }
+
+func New(c Caller) Resolver { return Resolver{C: c} }
+
+// Repository is what the engine sends for a reference: the name as written,
+// without Docker's docker.io/ or library/ normalization.
+func Repository(ref string) (string, digest.Digest, error) {
+	named, err := reference.ParseNormalizedNamed(ref)
+	if err != nil {
+		return "", "", cerrdefs.ErrInvalidArgument.WithMessage(err.Error())
+	}
+	c, ok := named.(reference.Canonical)
+	if !ok {
+		return "", "", cerrdefs.ErrInvalidArgument.WithMessage("seafield: image reference needs a digest: " + ref)
+	}
+	if err := c.Digest().Validate(); err != nil {
+		return "", "", cerrdefs.ErrInvalidArgument.WithMessage(err.Error())
+	}
+	return reference.FamiliarName(named), c.Digest(), nil
+}
+
+func opID(op string) string {
+	b := make([]byte, 8)
+	_, _ = rand.Read(b)
+	return op + ":" + hex.EncodeToString(b)
+}
+
+func (r Resolver) open(ctx context.Context, op, repo string, dgst digest.Digest, offset uint64) (io.ReadCloser, ContentA, error) {
+	var a ContentA
+	rc, err := r.C.CallStream(ctx, sfcd.Image, op, &ContentQ{Request: sfcd.Request{OpID: opID(op)}, Repository: repo, Digest: dgst.String(), Offset: offset}, &a)
+	if err != nil {
+		var e *sfcd.Error
+		if errors.As(err, &e) && e.Code == sfcd.NotFound {
+			return nil, a, cerrdefs.ErrNotFound.WithMessage(fmt.Sprintf("%s@%s: %v", repo, dgst, err))
+		}
+		return nil, a, err
+	}
+	if a.Size < 0 || uint64(a.Size) < offset {
+		rc.Close()
+		return nil, a, fmt.Errorf("seafield: sfcd answered a bad size for %s@%s", repo, dgst)
+	}
+	return rc, a, nil
+}
+
+// Resolve reads the manifest the reference's digest names.
+func (r Resolver) Resolve(ctx context.Context, ref string) (string, ocispec.Descriptor, error) {
+	repo, dgst, err := Repository(ref)
+	if err != nil {
+		return "", ocispec.Descriptor{}, err
+	}
+	rc, a, err := r.open(ctx, "manifest", repo, dgst, 0)
+	if err != nil {
+		return "", ocispec.Descriptor{}, err
+	}
+	defer rc.Close()
+	v := dgst.Verifier()
+	n, err := io.Copy(v, io.LimitReader(rc, a.Size+1))
+	if err != nil {
+		return "", ocispec.Descriptor{}, err
+	}
+	if n != a.Size || !v.Verified() {
+		return "", ocispec.Descriptor{}, fmt.Errorf("seafield: manifest %s@%s does not match its digest", repo, dgst)
+	}
+	return ref, ocispec.Descriptor{MediaType: a.ContentType, Digest: dgst, Size: a.Size}, nil
+}
+
+func (r Resolver) Fetcher(_ context.Context, ref string) (remotes.Fetcher, error) {
+	repo, _, err := Repository(ref)
+	if err != nil {
+		return nil, err
+	}
+	return fetcher{r: r, repo: repo}, nil
+}
+
+func (r Resolver) Pusher(context.Context, string) (remotes.Pusher, error) {
+	return nil, ErrNoRegistry
+}
+
+type fetcher struct {
+	r    Resolver
+	repo string
+}
+
+func isManifest(mt string) bool { return images.IsManifestType(mt) || images.IsIndexType(mt) }
+
+// Fetch returns the content from offset 0; containerd seeks to resume a
+// partial download, which reopens the stream at that offset.
+func (f fetcher) Fetch(ctx context.Context, desc ocispec.Descriptor) (io.ReadCloser, error) {
+	op := "blob"
+	if isManifest(desc.MediaType) {
+		op = "manifest"
+	}
+	return &reader{ctx: ctx, f: f, op: op, desc: desc}, nil
+}
+
+// FetchReferrers: sfcd serves no referrers.
+func (f fetcher) FetchReferrers(context.Context, digest.Digest, ...remotes.FetchReferrersOpt) ([]ocispec.Descriptor, error) {
+	return nil, nil
+}
+
+type reader struct {
+	ctx    context.Context
+	f      fetcher
+	op     string
+	desc   ocispec.Descriptor
+	offset int64
+	rc     io.ReadCloser
+}
+
+func (r *reader) Read(p []byte) (int, error) {
+	if r.rc == nil {
+		rc, a, err := r.f.r.open(r.ctx, r.op, r.f.repo, r.desc.Digest, uint64(r.offset))
+		if err != nil {
+			return 0, err
+		}
+		if r.desc.Size > 0 && a.Size != r.desc.Size {
+			rc.Close()
+			return 0, fmt.Errorf("seafield: %s@%s is %d bytes, expected %d", r.f.repo, r.desc.Digest, a.Size, r.desc.Size)
+		}
+		r.rc = rc
+	}
+	n, err := r.rc.Read(p)
+	r.offset += int64(n)
+	return n, err
+}
+
+// Seek moves the next read; only absolute offsets before any read or after
+// a reopen are supported, which is all containerd's resume needs.
+func (r *reader) Seek(offset int64, whence int) (int64, error) {
+	if whence != io.SeekStart || offset < 0 {
+		return r.offset, errors.New("seafield: only absolute seeks")
+	}
+	if r.rc != nil {
+		if offset == r.offset {
+			return offset, nil
+		}
+		r.rc.Close()
+		r.rc = nil
+	}
+	r.offset = offset
+	return offset, nil
+}
+
+func (r *reader) Close() error {
+	if r.rc != nil {
+		return r.rc.Close()
+	}
+	return nil
+}
+
+var _ remotes.Resolver = Resolver{}
